<!DOCTYPE html>
<html lang="en" data-theme="emerald">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Favicon: Modern SVG with crisp 'P' emblem + multi-resolution fallbacks -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#10b981" />

    <!-- Immediate Theme Setup (Zero FOUC) -->
    <script>
      (function() {
        try {
          var saved = localStorage.getItem('theme');
          var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'forest' : 'emerald');
          document.documentElement.setAttribute('data-theme', theme);
        } catch(e) {}
      })();
    </script>

    <!-- Comprehensive Google & Bing SEO Optimization, OpenGraph, Twitter, & Schema.org JSON-LD -->
    {% include "components/seo.njk" %}
    <link
      rel="alternate"
      type="application/atom+xml"
      title="Parag Chatterjee Blog RSS Feed"
      href="/feed.xml"
    />
    <link rel="stylesheet" href="/styles/index.css" />

    <!-- Typography: Plus Jakarta Sans (Sans-Serif) & JetBrains Mono (Monospace) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Netlify Identity Widget for CMS Authentication -->
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <style>
      body {
        font-family:
          "Plus Jakarta Sans",
          system-ui,
          -apple-system,
          sans-serif;
      }
      code,
      pre,
      kbd,
      samp,
      .font-mono {
        font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-base-100 text-base-content antialiased selection:bg-primary selection:text-primary-content">
    <!-- Top Announcement / Status Bar with Public Close / Dismiss Button (Editable via Admin) -->
    {% set currentBanner = topBanner or banner %}
    {% if currentBanner.enabled != false %}
    <div id="site-top-banner" class="bg-primary/10 border-b border-primary/20 text-xs py-1.5 px-4 font-medium print:hidden relative transition-all duration-300">
      <div class="max-w-6xl mx-auto flex items-center justify-between gap-2">
        <div class="w-6 shrink-0 sm:block hidden"></div>
        <div class="grow text-center flex flex-wrap items-center justify-center gap-1.5">
          {% if currentBanner.showPulse != false %}
          <span class="inline-flex items-center justify-center relative w-2 h-2 mr-1">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-success opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-success"></span>
          </span>
          {% endif %}
          <span>{{ currentBanner.text or "BCA (Hons) 4 Years (Batch 2023–2027) • Techno India (Hooghly Campus), MAKAUT" }}</span>
          {% if currentBanner.linkText %}
          {% set isExtBanner = (currentBanner.linkUrl or '') | startsWith('http') %}
          <a href="{{ currentBanner.linkUrl or '/about/' }}" {% if isExtBanner %}target="_blank" rel="noopener noreferrer"{% endif %} class="text-primary font-bold hover:underline ml-1 group inline-flex items-center gap-1">
            <span>{{ currentBanner.linkText | replace("→", "") | trim }}</span>
            {% if isExtBanner %}
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
            {% else %}
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 transition-transform duration-200 group-hover:translate-x-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
            {% endif %}
          </a>
          {% endif %}
        </div>
        <button
          type="button"
          id="close-banner-btn"
          onclick="dismissTopBanner()"
          class="btn btn-ghost btn-circle btn-xs text-base-content/60 hover:text-base-content hover:bg-primary/20 shrink-0"
          aria-label="Close banner"
          title="Close banner"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </button>
      </div>
    </div>
    <script>
      (function() {
        if (sessionStorage.getItem('top-banner-closed') === 'true') {
          var el = document.getElementById('site-top-banner');
          if (el) el.style.display = 'none';
        }
      })();
      function dismissTopBanner() {
        var el = document.getElementById('site-top-banner');
        if (el) {
          el.style.display = 'none';
          sessionStorage.setItem('top-banner-closed', 'true');
        }
      }
    </script>
    {% endif %}

    <!-- Navigation Bar Component -->
    {% include "components/navbar.njk" %}

    <!-- Main Content Slot -->
    <main class="grow">
      {{ content | safe }}
    </main>

    <!-- Global Footer Component -->
    {% include "components/footer.njk" %}

    <!-- Netlify Identity Admin Redirect Script -->
    <script>
      localStorage.removeItem("site-theme");

if (window.netlifyIdentity) {
  window.netlifyIdentity.on("init", user => {
    if (!user) {
      window.netlifyIdentity.on("login", () => {
        document.location.href = "/admin/";
      });
    }
  });
}
    </script>

    <!-- GSAP & Lenis Smooth Scrolling Engine (Subtle & Fluid) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
    <script src="https://unpkg.com/lenis@1.1.20/dist/lenis.min.js"></script>
    <script>
      (function() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          return;
        }

        function initLenis() {
          if (typeof Lenis === 'undefined') return;

          var lenis = new Lenis({
            duration: 0.85,
            easing: function(t) {
              return Math.min(1, 1.001 - Math.pow(2, -10 * t));
            },
            orientation: 'vertical',
            gestureOrientation: 'vertical',
            smoothWheel: true,
            wheelMultiplier: 0.95,
            touchMultiplier: 1.2
          });

          window.lenis = lenis;

          if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
            gsap.registerPlugin(ScrollTrigger);
            lenis.on('scroll', ScrollTrigger.update);
            gsap.ticker.add(function(time) {
              lenis.raf(time * 1000);
            });
            gsap.ticker.lagSmoothing(0);
          } else {
            function raf(time) {
              lenis.raf(time);
              requestAnimationFrame(raf);
            }
            requestAnimationFrame(raf);
          }
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initLenis);
        } else {
          initLenis();
        }
      })();
    </script>

    <!-- Global Dark Mode Controller Script -->
    <script>
      function getActiveTheme() {
        return document.documentElement.getAttribute('data-theme') || 'emerald';
      }

      function syncThemeUI(theme) {
        var isDark = theme === 'forest';
        var sunIcons = document.querySelectorAll('.theme-icon-sun');
        var moonIcons = document.querySelectorAll('.theme-icon-moon');
        var btns = document.querySelectorAll('#theme-toggle-btn');

        sunIcons.forEach(function(icon) {
          if (isDark) {
            icon.classList.remove('hidden');
            icon.classList.add('inline-block');
          } else {
            icon.classList.add('hidden');
            icon.classList.remove('inline-block');
          }
        });

        moonIcons.forEach(function(icon) {
          if (isDark) {
            icon.classList.add('hidden');
            icon.classList.remove('inline-block');
          } else {
            icon.classList.remove('hidden');
            icon.classList.add('inline-block');
          }
        });

        btns.forEach(function(btn) {
          btn.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
          btn.setAttribute('title', isDark ? 'Switch to light mode' : 'Switch to dark mode');
        });

        var metaThemeColor = document.querySelector('meta[name="theme-color"]');
        if (metaThemeColor) {
          metaThemeColor.setAttribute('content', isDark ? '#171212' : '#10b981');
        }
      }

      function setTheme(theme) {
        document.documentElement.setAttribute('data-theme', theme);
        try {
          localStorage.setItem('theme', theme);
        } catch(e) {}
        syncThemeUI(theme);
      }

      function toggleTheme() {
        var current = getActiveTheme();
        var next = current === 'forest' ? 'emerald' : 'forest';
        setTheme(next);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
          syncThemeUI(getActiveTheme());
        });
      } else {
        syncThemeUI(getActiveTheme());
      }

      try {
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
          if (!localStorage.getItem('theme')) {
            setTheme(e.matches ? 'forest' : 'emerald');
          }
        });
      } catch(e) {}
    </script>

    <!-- Automatic External Outlink Enhancement Script -->
    <script>
      (function() {
        function markExternalLinks() {
          var links = document.querySelectorAll('a[href]');
          var currentHost = window.location.hostname;
          var svgIcon = '<svg xmlns="http://www.w3.org/2000/svg" class="outlink-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>';

          links.forEach(function(link) {
            var href = link.getAttribute('href');
            if (!href) return;
            var trimmed = href.trim();
            if (trimmed.startsWith('#') || trimmed.startsWith('mailto:') || trimmed.startsWith('tel:') || trimmed.startsWith('javascript:')) return;
            if (trimmed.startsWith('http://') || trimmed.startsWith('https://')) {
              try {
                var url = new URL(trimmed, window.location.origin);
                if (url.hostname && url.hostname !== currentHost && url.hostname !== 'localhost' && url.hostname !== '127.0.0.1') {
                  if (!link.hasAttribute('target')) link.setAttribute('target', '_blank');
                  if (!link.hasAttribute('rel')) link.setAttribute('rel', 'noopener noreferrer');
                  var hasIcon = link.querySelector('svg, img') || link.classList.contains('btn-circle') || link.classList.contains('btn-square') || link.classList.contains('no-outlink');
                  if (!hasIcon) {
                    link.classList.add('inline-flex', 'items-center');
                    link.insertAdjacentHTML('beforeend', svgIcon);
                  }
                }
              } catch(e) {}
            }
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', markExternalLinks);
        } else {
          markExternalLinks();
        }
      })();
    </script>
  </body>
</html>
