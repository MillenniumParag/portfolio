<!DOCTYPE html>
<html lang="en" data-theme="emerald">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Comprehensive Google & Bing SEO Optimization, OpenGraph, Twitter, & Schema.org JSON-LD -->
    {% include "components/seo.njk" %}
    <link
      rel="alternate"
      type="application/atom+xml"
      title="Parag Chatterjee Blog RSS Feed"
      href="/feed.xml"
    />
    <link rel="stylesheet" href="/styles/index.css" />

    <!-- Typography: Plus Jakarta Sans (Sans-Serif) & JetBrains Mono (Monospace) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Netlify Identity Widget for CMS Authentication -->
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <style>
      body {
        font-family:
          "Plus Jakarta Sans",
          system-ui,
          -apple-system,
          sans-serif;
      }
      code,
      pre,
      kbd,
      samp,
      .font-mono {
        font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-base-100 text-base-content antialiased selection:bg-primary selection:text-primary-content">
    <!-- Top Announcement / Status Bar using daisyUI alert/badge style -->
    <div class="bg-primary/10 border-b border-primary/20 text-xs py-1.5 px-4 text-center font-medium print:hidden">
      <span class="inline-flex items-center gap-1.5">
        <span
          class="inline-block w-2 h-2 rounded-full bg-success animate-ping"
        ></span>
        <span
          class="inline-block w-2 h-2 rounded-full bg-success -ml-3.5"
        ></span>
        <span>BCA (Hons) 4 Years (Batch 2023–2027) • Techno India (Hooghly Campus), MAKAUT</span>
        <a href="{{ site.social.linkedin or 'https://www.linkedin.com/in/chatterjeeparag/' }}" target="_blank" rel="noopener noreferrer" class="text-primary font-bold hover:underline ml-1"
        >Connect on LinkedIn ↗</a>
      </span>
    </div>

    <!-- Navigation Bar Component -->
    {% include "components/navbar.njk" %}

    <!-- Main Content Slot -->
    <main class="grow">
      {{ content | safe }}
    </main>

    <!-- Global Footer Component -->
    {% include "components/footer.njk" %}

    <!-- Theme Persist & Netlify Identity Script -->
    <script>
    function setTheme(theme) {
  document.documentElement.setAttribute("data-theme", theme);
  localStorage.setItem("site-theme", theme);
}
const savedTheme = localStorage.getItem("site-theme");
if (savedTheme) {
  document.documentElement.setAttribute("data-theme", savedTheme);
}

if (window.netlifyIdentity) {
  window.netlifyIdentity.on("init", user => {
    if (!user) {
      window.netlifyIdentity.on("login", () => {
        document.location.href = "/admin/";
      });
    }
  });
}
    </script>
  </body>
</html>
