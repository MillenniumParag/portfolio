---
layout: layouts/base.njk
---

<div class="max-w-6xl mx-auto px-4 py-12 sm:px-6">
  <!-- Page Header -->
  <header class="mb-12 flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8 border-b border-base-200">
    <div class="max-w-2xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/10 text-accent font-bold text-xs mb-4">
        <span>{{ badgeText or "Curriculum Vitae • Batch of 2023–2027 • BCA (Hons) 4 Years" }}</span>
      </div>
      <h1 class="text-4xl sm:text-6xl font-black tracking-tight mb-4 leading-tight">
        {{ headline or "Experience & Academic Journey" }}
      </h1>
      <p class="text-lg text-base-content/75 leading-relaxed">
        {{ intro }}
      </p>
    </div>

    <div class="flex flex-wrap gap-3">
      <a href="{{ site.social.linkedin or 'https://www.linkedin.com/in/chatterjeeparag/' }}" target="_blank" rel="noopener noreferrer" class="btn btn-primary rounded-xl font-bold">
        Connect on LinkedIn ↗
      </a>
      <a href="/resume/" class="btn btn-outline rounded-xl">
        View Full Resume
      </a>
    </div>
  </header>

  <!-- Career Timeline Section -->
  <section class="mb-16">
    <h2 class="text-2xl font-black tracking-tight mb-8 flex items-center gap-2">
      <span class="w-3 h-3 rounded-full bg-primary"></span>
      Experience Timeline
    </h2>

    <div class="space-y-8 relative before:absolute before:inset-0 before:left-3.5 sm:before:left-4 before:w-0.5 before:bg-base-300">
      {% for item in timeline %}
        <div class="relative pl-10 sm:pl-12 group">
          <div class="absolute left-1.5 sm:left-2 top-1.5 w-5 h-5 rounded-full bg-primary border-4 border-base-100"></div>
          <div class="card bg-base-100 border border-base-200 p-6 sm:p-8 rounded-2xl">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
              <div>
                <h3 class="text-xl font-black text-base-content">
                  {{ item.role }}
                </h3>
                <p class="text-sm font-semibold text-primary">
                  {{ item.company }} • {{ item.type }}
                </p>
              </div>
              <div class="text-xs font-mono text-base-content/60 bg-base-200/80 px-3 py-1.5 rounded-lg w-fit">
                {{ item.period }} • {{ item.location }}
              </div>
            </div>

            <p class="text-sm text-base-content/75 mb-4 leading-relaxed">
              {{ item.description }}
            </p>

            {% if item.highlights %}
              <div class="space-y-1.5 mb-4">
                <div class="text-xs font-bold uppercase tracking-wider text-base-content/60">Key Contributions:</div>
                <ul class="list-disc list-inside text-xs text-base-content/75 space-y-1 pl-1">
                  {% for h in item.highlights %}
                    <li>{{ h }}</li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}

            <div class="flex flex-wrap gap-1.5 pt-2 border-t border-base-200">
              {% for skill in item.skills %}
                <span class="badge badge-sm badge-ghost font-mono text-xs">{{ skill }}</span>
              {% endfor %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </section>

  <!-- Education & Honors -->
  <section class="mb-16">
    <h2 class="text-2xl font-black tracking-tight mb-6 flex items-center gap-2">
      <span class="w-3 h-3 rounded-full bg-secondary"></span>
      Education &amp; Honors
    </h2>

    <div class="card bg-base-100 border border-base-200 p-8 rounded-3xl">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
        <div>
          <h3 class="text-2xl font-black">{{ educationCard.degree }}</h3>
          <p class="text-sm text-primary font-semibold">{{ educationCard.school }}</p>
        </div>
        <div class="text-xs font-mono bg-base-200 px-3 py-1 rounded-lg w-fit">
          {{ educationCard.period }} • {{ educationCard.gpa }}
        </div>
      </div>
      <div class="space-y-2 mt-4 pt-4 border-t border-base-200">
        <div class="text-xs font-bold uppercase tracking-wider text-base-content/60">Academic Honors &amp; Awards:</div>
        <ul class="list-disc list-inside text-sm text-base-content/75 space-y-1">
          {% for honor in educationCard.honors %}
            <li>{{ honor }}</li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </section>
</div>
