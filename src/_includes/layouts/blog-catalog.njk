---
layout: layouts/base.njk
---

{% from "components/page-header.njk" import pageHeader %}
{% from "components/article-card.njk" import articleCard %}

<div class="max-w-6xl mx-auto px-4 py-12 sm:px-6">
  <!-- Reusable Page Header Component -->
  {{
    pageHeader(
      title=headerTitle or "Engineering Journal & Notes",
      description=headerDescription or "Reflections on distributed systems, modern frontend tooling, database benchmarking, and practical lessons learned while building web applications.",
      badgeText=badgeText,
      badgeType="primary"
    )
  }}

  {% set allPosts = collections.post | reverse %}

  {% if allPosts and allPosts.length > 0 %}
    <!-- Articles List using DaisyUI List Component -->
    <ul class="list bg-base-100 rounded-3xl border border-base-200 shadow-sm overflow-hidden" id="blog-list">
      <li class="p-4 pb-2 text-xs font-mono uppercase tracking-wider text-base-content/60 flex items-center justify-between border-b border-base-200/50">
        <span>Published Articles &amp; Insights ({{ allPosts.length }})</span>
        <span class="hidden sm:inline">Chronological Archive</span>
      </li>
      {% for post in allPosts %}
        {{ articleCard(post) }}
      {% endfor %}
    </ul>
  {% else %}
    <div class="card bg-base-100 border border-base-200 p-10 sm:p-16 text-center rounded-3xl max-w-xl mx-auto my-8 space-y-4">
      <div class="w-16 h-16 rounded-2xl bg-base-200 text-base-content/40 mx-auto flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
        </svg>
      </div>
      <div>
        <h3 class="text-2xl font-bold text-base-content">Nothing here for now</h3>
        <p class="text-sm text-base-content/60 mt-1.5 max-w-sm mx-auto">
          No articles published yet. Please check back soon!
        </p>
      </div>
      <div class="pt-2 flex flex-wrap justify-center gap-3">
        <a href="/about/" class="btn btn-outline btn-sm rounded-xl font-bold">
          Read About Me →
        </a>
      </div>
    </div>
  {% endif %}
</div>
