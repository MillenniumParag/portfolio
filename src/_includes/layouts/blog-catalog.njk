---
layout: layouts/base.njk

---

{% from "components/page-header.njk" import pageHeader %}
{% from "components/article-card.njk" import articleCard %}

<div class="max-w-6xl mx-auto px-4 py-12 sm:px-6">
  <!-- Reusable Page Header Component -->
  {{
    pageHeader(
      title=headerTitle or "Engineering Journal & Notes",
      description=headerDescription or "Reflections on distributed systems, modern frontend tooling, database benchmarking, and practical lessons learned while building web applications.",
      badgeText=badgeText,
      badgeType="primary"
    )
  }}

  {% set allPosts = collections.post | reverse %}
  {% set featuredPost = null %}
  {% for post in allPosts %}
    {% if post.data.featured and not featuredPost %}
      {% set featuredPost = post %}
    {% endif %}
  {% endfor %}
  {% if not featuredPost %}
    {% set featuredPost = allPosts | first %}
  {% endif %}

  {% if allPosts and allPosts.length > 0 %}
    <!-- Medium-Inspired Featured Story Hero Banner -->
    {% if featuredPost %}
      <div class="card bg-base-100 border border-base-200 rounded-3xl overflow-hidden mb-14 group">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 p-6 sm:p-10 items-center">
          <!-- Left: Featured Banner Image -->
          <div class="lg:col-span-7">
            <a
              href="{{ featuredPost.url }}"
              class="block relative aspect-video rounded-2xl overflow-hidden border border-base-200 bg-base-200"
            >
              {% if featuredPost.data.image %}
                <img
                  src="{{ featuredPost.data.image }}"
                  alt="{{ featuredPost.data.title }}"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
                  loading="eager"
                />
              {% else %}
                <div class="w-full h-full bg-linear-to-br from-primary/20 via-base-200 to-base-300 flex items-center justify-center p-8 text-primary">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                  </svg>
                </div>
              {% endif %}

              <!-- Floating Top Badge -->
              <div class="absolute top-4 left-4">
                <span
                  class="badge badge-primary font-bold text-xs uppercase tracking-wider backdrop-blur-md shadow-sm inline-flex items-center gap-1.5"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                  Featured Lead Story
                </span>
              </div>
            </a>
          </div>

          <!-- Right: Story Meta & Excerpt -->
          <div class="lg:col-span-5 space-y-4">
            <!-- Author Byline -->
            <div class="flex items-center gap-3 text-xs text-base-content/70">
              <div class="avatar placeholder">
                <div class="bg-primary text-primary-content rounded-full w-7 h-7 text-xs font-bold flex items-center justify-center">
                  {{ (featuredPost.data.author or 'P')[0] }}
                </div>
              </div>
              <div>
                <div class="font-bold text-base-content">
                  {{ featuredPost.data.author or "Parag Chatterjee" }}
                </div>
                <div class="text-[11px] text-base-content/60">
                  {{ featuredPost.date | readableDate }} • 5 min read
                </div>
              </div>
            </div>

            <!-- Title -->
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black group-hover:text-primary transition-colors leading-tight">
              <a href="{{ featuredPost.url }}">
                {{ featuredPost.data.title }}
              </a>
            </h2>

            <!-- Excerpt -->
            <p class="text-base-content/75 text-sm sm:text-base leading-relaxed line-clamp-3">
              {{ featuredPost.data.description }}
            </p>

            <!-- Tags -->
            {% if featuredPost.data.tags %}
              <div class="flex flex-wrap gap-1.5 pt-1">
                {% for tag in featuredPost.data.tags %}
                  {% if tag != "post" %}
                    <span class="badge badge-sm badge-ghost font-mono text-xs">{{
                      tag
                    }}</span>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}

            <!-- CTA Button -->
            <div class="pt-2">
              <a
                href="{{ featuredPost.url }}"
                class="btn btn-primary rounded-xl px-6 text-sm font-bold"
              >
                Read Featured Story →
              </a>
            </div>
          </div>
        </div>
      </div>
    {% endif %}

    <!-- Section Title for Remaining Stories -->
    <div class="flex items-center justify-between mb-8 pb-3 border-b border-base-200">
      <h3 class="text-xl font-black flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        <span>All Articles &amp; Insights</span>
      </h3>
      <span class="text-xs text-base-content/60 font-mono"
      >Chronological Archive</span>
    </div>

    <!-- Articles List using Reusable ArticleCard Component -->
    <div class="space-y-6">
      {% for post in allPosts %}
        {% if post.url != featuredPost.url %}
          {{ articleCard(post) }}
        {% endif %}
      {% endfor %}
    </div>
  {% else %}
    <div class="card bg-base-100 border border-base-200 p-10 sm:p-16 text-center rounded-3xl max-w-xl mx-auto my-8 space-y-4">
      <div class="w-16 h-16 rounded-2xl bg-base-200 text-base-content/40 mx-auto flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
        </svg>
      </div>
      <div>
        <h3 class="text-2xl font-bold text-base-content">Nothing here for now</h3>
        <p class="text-sm text-base-content/60 mt-1.5 max-w-sm mx-auto">
          No articles published yet. Please check back soon!
        </p>
      </div>
      <div class="pt-2 flex flex-wrap justify-center gap-3">
        <a href="/about/" class="btn btn-outline btn-sm rounded-xl font-bold">
          Read About Me →
        </a>
      </div>
    </div>
  {% endif %}
</div>
