---
layout: layouts/base.njk
---

<div class="max-w-6xl mx-auto px-4 py-12 sm:px-6">
  <header class="mb-8 pb-6 border-b border-base-200">
    <h1 class="text-3xl sm:text-5xl font-black tracking-tight mb-3">
      {{ title }}
    </h1>
    {% if description %}
      <p class="text-lg text-base-content/70">
        {{ description }}
      </p>
    {% endif %}
  </header>

  <div class="prose prose-lg max-w-none text-base-content leading-relaxed space-y-4">
    {{ content | safe }}
  </div>
</div>
