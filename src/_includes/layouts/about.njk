---
layout: layouts/base.njk
---

{% from "components/cta-banner.njk" import ctaBanner %}

{% set ws = workstation or uses %}

<div class="max-w-5xl mx-auto px-4 py-12 sm:px-6">
  <!-- Top Tab Switcher: "About Me" & "Uses & Workstation" -->
  <div class="flex justify-center mb-10">
    <div class="inline-flex p-1.5 rounded-2xl bg-base-200 border border-base-300 gap-1.5 shadow-xs">
      <button
        id="tab-btn-me"
        type="button"
        onclick="setActiveTab('me')"
        class="btn btn-sm rounded-xl font-bold transition-all btn-primary shadow-xs gap-2"
        aria-selected="true"
        aria-controls="tab-content-me"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        <span>About Me</span>
      </button>
      <button
        id="tab-btn-uses"
        type="button"
        onclick="setActiveTab('uses')"
        class="btn btn-sm rounded-xl font-bold transition-all btn-ghost text-base-content/70 hover:text-base-content gap-2"
        aria-selected="false"
        aria-controls="tab-content-uses"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <span>Uses &amp; Workstation</span>
      </button>
    </div>
  </div>

  <!-- ============================================== -->
  <!-- TAB 1: ABOUT ME                                -->
  <!-- ============================================== -->
  <div id="tab-content-me" class="space-y-16">
    <!-- Hero / Introduction -->
    <header class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center pb-12 border-b border-base-200">
      <div class="md:col-span-8 space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary font-bold text-xs">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{{ introBadge or "Hey, I'm Parag Chatterjee" }}</span>
        </div>
        <h1 class="text-4xl sm:text-6xl font-black tracking-tight leading-tight">
          {{ headline or "Turning curiosity & code into impactful software." }}
        </h1>
        <p class="text-lg text-base-content/75 leading-relaxed">
          {{ intro }}
        </p>
        <div class="flex flex-wrap gap-3 pt-2">
          <a href="{{ primaryButtonUrl or '/projects/' }}" class="btn btn-primary rounded-xl">
            {{ primaryButtonText or "Explore Projects" }}
          </a>
          <a href="{{ secondaryButtonUrl or 'https://www.linkedin.com/in/chatterjeeparag/' }}" {% if (secondaryButtonUrl or 'https://www.linkedin.com/in/chatterjeeparag/') | startsWith('http') %}target="_blank" rel="noopener noreferrer"{% endif %} class="btn btn-outline rounded-xl">
            {{ secondaryButtonText or "Connect on LinkedIn ↗" }}
          </a>
        </div>
      </div>

      <!-- Avatar / Bio Card -->
      <div class="md:col-span-4">
        <div class="card bg-base-100 border border-base-200 p-6 rounded-3xl text-center space-y-4">
          <div class="avatar online mx-auto">
            <div class="w-32 h-32 rounded-3xl overflow-hidden ring-4 ring-primary/20 shadow-xl shadow-primary/10 bg-primary/10">
              <img src="{{ bioCard.avatar or '/uploads/avatar.webp' }}" alt="{{ bioCard.name or 'Parag Chatterjee' }}" class="w-full h-full object-cover" width="128" height="128" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
              <div class="hidden w-full h-full bg-primary text-primary-content items-center justify-center text-4xl font-black">
                {{ (bioCard.name or 'P')[0] }}
              </div>
            </div>
          </div>
          <div>
            <h2 class="text-xl font-black">{{ bioCard.name or "Parag Chatterjee" }}</h2>
            <p class="text-xs text-primary font-semibold">{{ bioCard.role or "BCA (Hons) '27 • Junior SDE" }}</p>
          </div>
          <div class="text-xs text-base-content/70 leading-relaxed">
            {{ bioCard.summary or "Grounded in core CS fundamentals, eager to build with Java, Spring Boot, React, and AWS." }}
          </div>
          <div class="divider my-1"></div>
          <div class="flex justify-center gap-2">
            <span class="badge badge-sm badge-ghost font-mono">{{ bioCard.badge1 or "Fresher" }}</span>
            <span class="badge badge-sm badge-success badge-outline font-semibold">{{ bioCard.badge2 or "Janai, Hooghly" }}</span>
          </div>
        </div>
      </div>
    </header>

    <!-- The Journey Story Section -->
    <section>
      <div class="max-w-3xl">
        <h2 class="text-2xl sm:text-3xl font-black tracking-tight mb-6">
          {{ storyTitle or "The College Journey & Engineering Curiosity" }}
        </h2>
        <div class="space-y-4 text-base-content/80 leading-relaxed">
          {% for para in storyParagraphs %}
            <p>{{ para }}</p>
          {% endfor %}
        </div>
      </div>
    </section>

    <!-- Education & Foundations Card -->
    <section>
      <div class="card bg-base-200/50 border border-base-300 p-8 rounded-3xl">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
          <div>
            <span class="badge badge-primary font-bold text-xs uppercase tracking-wider mb-2">Academic Foundation</span>
            <h3 class="text-2xl font-black">{{ education.degree or "Bachelor of Computer Applications (Honours) — 4 Years" }}</h3>
            <p class="text-sm text-base-content/70">{{ education.school or "Techno India (Hooghly Campus) — Affiliated to MAKAUT University" }} • {{ education.period or "2023 – 2027" }}</p>
          </div>
          <span class="badge badge-lg badge-outline font-mono font-bold">{{ education.gpa or "GPA: 7.89" }}</span>
        </div>
        <p class="text-sm text-base-content/75 mb-6 leading-relaxed">
          {{ education.description }}
        </p>
        <div>
          <div class="text-xs font-bold uppercase tracking-wider text-base-content/60 mb-2">Core Coursework</div>
          <div class="flex flex-wrap gap-2">
            {% for course in education.coursework %}
              <span class="badge badge-ghost text-xs">{{ course }}</span>
            {% endfor %}
          </div>
        </div>
      </div>
    </section>

    <!-- Principles & Quick Facts -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Principles -->
      <div class="card bg-base-100 border border-base-200 p-8 rounded-3xl space-y-4">
        <h3 class="text-xl font-black">What I Bring to a Team</h3>
        <div class="space-y-4 text-sm text-base-content/75">
          {% for principle in principles %}
            <div>
              <h4 class="font-bold text-base-content mb-1">{{ principle.title }}</h4>
              <p>{{ principle.description }}</p>
            </div>
          {% endfor %}
        </div>
      </div>

      <!-- Quick Facts -->
      <div class="card bg-base-100 border border-base-200 p-8 rounded-3xl space-y-4">
        <h3 class="text-xl font-black">Quick Facts</h3>
        <div class="space-y-3 text-sm">
          {% for fact in quickFacts %}
            <div class="flex justify-between py-2 border-b border-base-200">
              <span class="text-base-content/60 font-medium">{{ fact.label }}</span>
              <span class="font-bold text-base-content text-right">{{ fact.value }}</span>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>

    <!-- Call to Action -->
    <div class="pt-4">
      {{ ctaBanner(
        title=cta.title or "Interested in working together or hiring?",
        subtitle=cta.subtitle or "I'm eager to connect with engineering teams, hiring managers, and mentors.",
        buttonText=cta.buttonText or "Connect on LinkedIn →",
        buttonUrl=cta.buttonUrl or "https://www.linkedin.com/in/chatterjeeparag/"
      ) }}
    </div>
  </div>

  <!-- ============================================== -->
  <!-- TAB 2: USES & WORKSTATION                      -->
  <!-- ============================================== -->
  <div id="tab-content-uses" class="hidden space-y-14">
    <!-- Header -->
    <header class="max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary font-bold text-xs mb-4">
        <span>{{ ws.badgeText or "Developer Setup • Updated 2026" }}</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-black tracking-tight mb-4 leading-tight">
        {{ ws.headline or "Operating Systems, Tools & Software I Rely On" }}
      </h2>
      <p class="text-lg text-base-content/75 leading-relaxed">
        {{ ws.intro or "A living document of my hardware, operating system configurations, development environment, and software workflows used for engineering." }}
      </p>
    </header>

    <!-- Workstation & Hardware -->
    <section>
      <div class="flex items-center justify-between mb-6 pb-2 border-b border-base-200">
        <h3 class="text-2xl font-black flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>Workstation &amp; Hardware</span>
        </h3>
        <span class="badge badge-primary badge-outline text-xs">Hardware</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {% for item in ws.hardware %}
          <div class="card bg-base-100 border border-base-200 p-6 rounded-2xl">
            <h4 class="font-black text-lg mb-1">{{ item.title }}</h4>
            <p class="text-sm text-base-content/75 mb-3">{{ item.description }}</p>
            <div class="flex flex-wrap gap-2">
              {% for b in item.badges %}
                <span class="badge badge-sm badge-ghost font-mono">{{ b }}</span>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    </section>

    <!-- Code Editors & Dev Tools -->
    <section>
      <div class="flex items-center justify-between mb-6 pb-2 border-b border-base-200">
        <h3 class="text-2xl font-black flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
          </svg>
          <span>Code Editors &amp; Dev Tools</span>
        </h3>
        <span class="badge badge-primary badge-outline text-xs">Software</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {% for item in ws.devtools %}
          <div class="card bg-base-100 border border-base-200 p-6 rounded-2xl">
            <h4 class="font-black text-lg mb-1">{{ item.title }}</h4>
            <p class="text-sm text-base-content/75 mb-3">{{ item.description }}</p>
            <div class="flex flex-wrap gap-2">
              {% for b in item.badges %}
                <span class="badge badge-sm badge-ghost font-mono">{{ b }}</span>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    </section>

    <!-- Terminal & CLI Tools -->
    <section>
      <div class="flex items-center justify-between mb-6 pb-2 border-b border-base-200">
        <h3 class="text-2xl font-black flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>Terminal &amp; CLI Tools</span>
        </h3>
        <span class="badge badge-primary badge-outline text-xs">Environment</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {% for item in ws.terminal %}
          <div class="card bg-base-100 border border-base-200 p-6 rounded-2xl">
            <h4 class="font-black text-lg mb-1">{{ item.title }}</h4>
            <p class="text-sm text-base-content/75 mb-3">{{ item.description }}</p>
            <div class="flex flex-wrap gap-2">
              {% for b in item.badges %}
                <span class="badge badge-sm badge-ghost font-mono">{{ b }}</span>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    </section>

    <!-- Productivity & Everyday Apps -->
    <section>
      <div class="flex items-center justify-between mb-6 pb-2 border-b border-base-200">
        <h3 class="text-2xl font-black flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Productivity &amp; Workflow</span>
        </h3>
        <span class="badge badge-primary badge-outline text-xs">Workflow</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {% for item in ws.productivity %}
          <div class="card bg-base-100 border border-base-200 p-6 rounded-2xl">
            <h4 class="font-black text-lg mb-1">{{ item.title }}</h4>
            <p class="text-sm text-base-content/75 mb-3">{{ item.description }}</p>
            <div class="flex flex-wrap gap-2">
              {% for b in item.badges %}
                <span class="badge badge-sm badge-ghost font-mono">{{ b }}</span>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    </section>

    <!-- Call to Action Banner -->
    <div class="pt-4">
      {{ ctaBanner(
        title=cta.title or "Interested in working together or hiring?",
        subtitle=cta.subtitle or "I'm eager to connect with engineering teams, hiring managers, and mentors.",
        buttonText=cta.buttonText or "Connect on LinkedIn →",
        buttonUrl=cta.buttonUrl or "https://www.linkedin.com/in/chatterjeeparag/"
      ) }}
    </div>
  </div>
</div>

<script>
  function setActiveTab(tab) {
    var meContent = document.getElementById('tab-content-me');
    var usesContent = document.getElementById('tab-content-uses');
    var meBtn = document.getElementById('tab-btn-me');
    var usesBtn = document.getElementById('tab-btn-uses');

    if (!meContent || !usesContent || !meBtn || !usesBtn) return;

    if (tab === 'uses') {
      meContent.classList.add('hidden');
      usesContent.classList.remove('hidden');

      meBtn.classList.remove('btn-primary', 'shadow-xs');
      meBtn.classList.add('btn-ghost', 'text-base-content/70');
      meBtn.setAttribute('aria-selected', 'false');

      usesBtn.classList.remove('btn-ghost', 'text-base-content/70');
      usesBtn.classList.add('btn-primary', 'shadow-xs');
      usesBtn.setAttribute('aria-selected', 'true');

      if (window.location.hash !== '#uses' && window.location.hash !== '#workstation') {
        history.replaceState(null, '', '#uses');
      }
    } else {
      usesContent.classList.add('hidden');
      meContent.classList.remove('hidden');

      usesBtn.classList.remove('btn-primary', 'shadow-xs');
      usesBtn.classList.add('btn-ghost', 'text-base-content/70');
      usesBtn.setAttribute('aria-selected', 'false');

      meBtn.classList.remove('btn-ghost', 'text-base-content/70');
      meBtn.classList.add('btn-primary', 'shadow-xs');
      meBtn.setAttribute('aria-selected', 'true');

      if (window.location.hash === '#uses' || window.location.hash === '#workstation') {
        history.replaceState(null, '', window.location.pathname);
      }
    }
  }

  function checkUrlForTab() {
    var hash = window.location.hash;
    var urlParams = new URLSearchParams(window.location.search);
    if (hash === '#uses' || hash === '#workstation' || urlParams.get('tab') === 'uses') {
      setActiveTab('uses');
    } else {
      setActiveTab('me');
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', checkUrlForTab);
  } else {
    checkUrlForTab();
  }
  window.addEventListener('hashchange', checkUrlForTab);
</script>
