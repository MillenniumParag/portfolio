---
layout: layouts/base.njk
---


{% set ws = workstation or uses %}

<div class="max-w-6xl mx-auto px-4 pt-12 pb-32 sm:px-6">

  <!-- ============================================== -->
  <!-- TAB 1: ABOUT ME                                -->
  <!-- ============================================== -->
  <div id="tab-content-me" class="space-y-16">
    <!-- Hero / Introduction -->
    <header class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center pb-12 border-b border-base-200">
      <div class="md:col-span-8 space-y-4">
        <h1 class="text-3xl sm:text-5xl font-black tracking-tight leading-tight">
          {{ headline or "Turning curiosity & code into impactful software." }}
        </h1>
        <p class="text-base sm:text-lg text-base-content/75 leading-relaxed">
          {{ intro }}
        </p>
        <div class="flex flex-wrap gap-3 pt-2">
          <a href="{{ primaryButtonUrl or '/projects/' }}" class="btn btn-primary rounded-xl">
            {{ primaryButtonText or "Explore Portfolio" }}
          </a>
          <a href="{{ secondaryButtonUrl or '/resume/' }}" class="btn btn-outline rounded-xl">
            {{ secondaryButtonText or "View Resume" }}
          </a>
        </div>
      </div>

      <!-- Avatar / Bio Card -->
      <div class="md:col-span-4">
        <div class="card bg-base-100 border border-base-200 p-6 rounded-3xl text-center space-y-4">
          <div class="avatar online mx-auto">
            <div class="w-32 h-32 rounded-3xl overflow-hidden ring-4 ring-primary/20 shadow-xl shadow-primary/10 bg-primary/10">
              <img src="{{ bioCard.avatar or '/uploads/me.avif' }}" alt="{{ bioCard.name or 'Parag Chatterjee' }}" class="w-full h-full object-cover" width="128" height="128" onerror="this.onerror=null; this.src='/uploads/me.webp';" />
              <div class="hidden w-full h-full bg-primary text-primary-content items-center justify-center text-4xl font-black">
                {{ (bioCard.name or 'P')[0] }}
              </div>
            </div>
          </div>
          <div>
            <h3 class="text-xl font-bold">{{ bioCard.name or "Parag Chatterjee" }}</h3>
            <p class="text-xs text-primary font-semibold">{{ bioCard.role or "BCA (Hons) '27 • Aspiring SDE" }}</p>
          </div>
          <div class="text-xs text-base-content/70 leading-relaxed">
            {{ bioCard.summary or "Grounded in core CS fundamentals, eager to build with Java, Spring Boot, React, and AWS." }}
          </div>
          <div class="divider my-1"></div>
          <div class="text-xs text-base-content/65 flex items-center justify-center gap-1.5 font-medium">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Janai, Hooghly, West Bengal</span>
          </div>
        </div>
      </div>
    </header>

    <!-- The Journey Story Section -->
    <section>
      <div class="max-w-3xl">
        <h2 class="text-2xl sm:text-3xl font-black tracking-tight mb-6">
          {{ storyTitle or "The College Journey & Engineering Curiosity" }}
        </h2>
        <div class="space-y-4 text-base-content/80 leading-relaxed">
          {% for para in storyParagraphs %}
            <p>{{ para }}</p>
          {% endfor %}
        </div>
      </div>
    </section>

    <!-- Education & Foundations Card -->
    <section>
      <div class="card bg-base-200/50 border border-base-300 p-8 rounded-3xl">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
          <div>
            <div class="text-xs font-bold uppercase tracking-wider text-primary mb-1">Academic Foundation</div>
            <h3 class="text-xl sm:text-2xl font-black">{{ education.degree or "Bachelor of Computer Applications (Honours) — 4 Years" }}</h3>
            <p class="text-sm text-base-content/70">{{ education.school or "Techno India (Hooghly Campus) — Affiliated to MAKAUT University" }} • {{ education.period or "2023 – 2027" }}</p>
          </div>
          <span class="badge badge-lg badge-outline font-mono font-bold">{{ education.gpa or "GPA: 7.89" }}</span>
        </div>
        <p class="text-sm text-base-content/75 mb-6 leading-relaxed">
          {{ education.description }}
        </p>
        <div>
          <div class="text-xs font-bold uppercase tracking-wider text-base-content/60 mb-2">Core Coursework</div>
          <div class="flex flex-wrap gap-2">
            {% for course in education.coursework %}
              <span class="badge badge-ghost text-xs">{{ course }}</span>
            {% endfor %}
          </div>
        </div>
      </div>
    </section>

    <!-- Principles & Quick Facts -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Principles -->
      <div class="card bg-base-100 border border-base-200 p-8 rounded-3xl space-y-4">
        <h3 class="text-xl font-bold">What I Bring to a Team</h3>
        <div class="space-y-4 text-sm text-base-content/75">
          {% for principle in principles %}
            <div>
              <h4 class="font-bold text-base-content mb-1">{{ principle.title }}</h4>
              <p>{{ principle.description }}</p>
            </div>
          {% endfor %}
        </div>
      </div>

      <!-- Quick Facts -->
      <div class="card bg-base-100 border border-base-200 p-8 rounded-3xl space-y-4">
        <h3 class="text-xl font-black">Quick Facts</h3>
        <div class="space-y-3 text-sm">
          {% for fact in quickFacts %}
            <div class="flex justify-between py-2 border-b border-base-200">
              <span class="text-base-content/60 font-medium">{{ fact.label }}</span>
              <span class="font-bold text-base-content text-right">{{ fact.value }}</span>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>


  </div>

  <!-- ============================================== -->
  <!-- TAB 2: EXPERIENCE & TRAINING                   -->
  <!-- ============================================== -->
  <div id="tab-content-exp" class="hidden space-y-14">
    <!-- Header -->
    <header class="max-w-3xl">
      <h2 class="text-2xl sm:text-3xl font-black tracking-tight mb-3 leading-tight">
        Industry Training &amp; Practical Experience
      </h2>
      <p class="text-base sm:text-lg text-base-content/75 leading-relaxed">
        Specialized enterprise bootcamps, practical cloud training programs, and academic development completed alongside my university coursework at Techno India (Hooghly Campus), MAKAUT.
      </p>
    </header>

    <!-- Career Timeline Section -->
    <section>
      <div class="flex items-center justify-between mb-8 pb-2 border-b border-base-200">
        <h3 class="text-xl font-bold flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-primary"></span>
          <span>Experience Timeline</span>
        </h3>
      </div>

      <div class="space-y-8 relative before:absolute before:inset-0 before:left-3.5 sm:before:left-4 before:w-0.5 before:bg-base-300">
        {% for item in timeline %}
          <div class="relative pl-10 sm:pl-12 group">
            <div class="absolute left-1.5 sm:left-2 top-1.5 w-5 h-5 rounded-full bg-primary border-4 border-base-100"></div>
            <div class="card bg-base-100 border border-base-200 p-6 sm:p-8 rounded-2xl">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
                <div>
                  <h4 class="text-lg font-bold text-base-content">
                    {{ item.role }}
                  </h4>
                  <p class="text-sm font-semibold text-primary">
                    {{ item.company }} • {{ item.type }}
                  </p>
                </div>
                <div class="text-xs font-mono text-base-content/60 bg-base-200/80 px-3 py-1.5 rounded-lg w-fit">
                  {{ item.period }} • {{ item.location }}
                </div>
              </div>

              <p class="text-sm text-base-content/75 mb-4 leading-relaxed">
                {{ item.description }}
              </p>

              {% if item.highlights %}
                <div class="space-y-1.5 mb-4">
                  <div class="text-xs font-bold uppercase tracking-wider text-base-content/60">Key Contributions:</div>
                  <ul class="list-disc list-inside text-xs text-base-content/75 space-y-1 pl-1">
                    {% for h in item.highlights %}
                      <li>{{ h }}</li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}

              <div class="flex flex-wrap gap-1.5 pt-2 border-t border-base-200">
                {% for skill in item.skills %}
                  <span class="badge badge-sm badge-ghost font-mono text-xs">{{ skill }}</span>
                {% endfor %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </section>

    <!-- Education & Honors Card -->
    {% if educationCard %}
      <section>
        <div class="card bg-base-100 border border-base-200 p-8 rounded-3xl">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
            <div>
              <div class="text-xs font-bold uppercase tracking-wider text-primary mb-1">Academic Credentials</div>
              <h3 class="text-xl sm:text-2xl font-black">{{ educationCard.degree }}</h3>
              <p class="text-sm text-primary font-semibold">{{ educationCard.school }}</p>
            </div>
            <div class="text-xs font-mono bg-base-200 px-3 py-1.5 rounded-lg w-fit font-bold">
              {{ educationCard.period }} • {{ educationCard.gpa }}
            </div>
          </div>
          <div class="space-y-2 mt-4 pt-4 border-t border-base-200">
            <div class="text-xs font-bold uppercase tracking-wider text-base-content/60">Academic Honors &amp; Awards:</div>
            <ul class="list-disc list-inside text-sm text-base-content/75 space-y-1">
              {% for honor in educationCard.honors %}
                <li>{{ honor }}</li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </section>
    {% endif %}


  </div>

  <!-- ============================================== -->
  <!-- TAB 3: USES & WORKSTATION                      -->
  <!-- ============================================== -->
  <div id="tab-content-uses" class="hidden space-y-14">
    <!-- Header -->
    <header class="max-w-3xl">
      <h2 class="text-2xl sm:text-3xl font-black tracking-tight mb-3 leading-tight">
        {{ ws.headline or "Operating Systems, Tools & Software I Rely On" }}
      </h2>
      <p class="text-base sm:text-lg text-base-content/75 leading-relaxed">
        {{ ws.intro or "A living document of my hardware, operating system configurations, development environment, and software workflows used for engineering." }}
      </p>
    </header>

    <!-- Workstation & Hardware -->
    <section>
      <div class="flex items-center justify-between mb-6 pb-2 border-b border-base-200">
        <h3 class="text-xl font-bold flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>Workstation &amp; Hardware</span>
        </h3>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {% for item in ws.hardware %}
          <div class="card bg-base-100 border border-base-200 p-6 rounded-2xl">
            <h4 class="font-black text-lg mb-1">{{ item.title }}</h4>
            <p class="text-sm text-base-content/75 mb-3">{{ item.description }}</p>
            <div class="flex flex-wrap gap-2">
              {% for b in item.badges %}
                <span class="badge badge-sm badge-ghost font-mono">{{ b }}</span>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    </section>

    <!-- Code Editors & Dev Tools -->
    <section>
      <div class="flex items-center justify-between mb-6 pb-2 border-b border-base-200">
        <h3 class="text-xl font-bold flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
          </svg>
          <span>Code Editors &amp; Dev Tools</span>
        </h3>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {% for item in ws.devtools %}
          <div class="card bg-base-100 border border-base-200 p-6 rounded-2xl">
            <h4 class="font-black text-lg mb-1">{{ item.title }}</h4>
            <p class="text-sm text-base-content/75 mb-3">{{ item.description }}</p>
            <div class="flex flex-wrap gap-2">
              {% for b in item.badges %}
                <span class="badge badge-sm badge-ghost font-mono">{{ b }}</span>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    </section>

    <!-- Terminal & CLI Tools -->
    <section>
      <div class="flex items-center justify-between mb-6 pb-2 border-b border-base-200">
        <h3 class="text-xl font-bold flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>Terminal &amp; CLI Tools</span>
        </h3>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {% for item in ws.terminal %}
          <div class="card bg-base-100 border border-base-200 p-6 rounded-2xl">
            <h4 class="font-black text-lg mb-1">{{ item.title }}</h4>
            <p class="text-sm text-base-content/75 mb-3">{{ item.description }}</p>
            <div class="flex flex-wrap gap-2">
              {% for b in item.badges %}
                <span class="badge badge-sm badge-ghost font-mono">{{ b }}</span>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    </section>

    <!-- Productivity & Everyday Apps -->
    <section>
      <div class="flex items-center justify-between mb-6 pb-2 border-b border-base-200">
        <h3 class="text-xl font-bold flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Productivity &amp; Workflow</span>
        </h3>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {% for item in ws.productivity %}
          <div class="card bg-base-100 border border-base-200 p-6 rounded-2xl">
            <h4 class="font-black text-lg mb-1">{{ item.title }}</h4>
            <p class="text-sm text-base-content/75 mb-3">{{ item.description }}</p>
            <div class="flex flex-wrap gap-2">
              {% for b in item.badges %}
                <span class="badge badge-sm badge-ghost font-mono">{{ b }}</span>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    </section>


  </div>
</div>

<!-- Floating Bottom Tab Controller -->
<div id="about-floating-tabs" class="fixed bottom-6 inset-x-0 z-40 flex justify-center pointer-events-none px-4 print:hidden">
  <div
    class="pointer-events-auto inline-flex items-center p-1.5 rounded-2xl frosted-glass gap-1.5 transition-all duration-300"
    role="tablist"
    aria-label="About section tabs"
  >
    <button
      id="tab-btn-me"
      type="button"
      role="tab"
      onclick="setActiveTab('me', true)"
      class="btn btn-sm rounded-xl font-bold transition-all btn-primary shadow-xs"
      aria-selected="true"
      aria-controls="tab-content-me"
    >
      <span>About</span>
    </button>

    <button
      id="tab-btn-exp"
      type="button"
      role="tab"
      onclick="setActiveTab('exp', true)"
      class="btn btn-sm rounded-xl font-bold transition-all btn-ghost text-base-content/70 hover:text-base-content"
      aria-selected="false"
      aria-controls="tab-content-exp"
    >
      <span>Experience</span>
    </button>

    <button
      id="tab-btn-uses"
      type="button"
      role="tab"
      onclick="setActiveTab('uses', true)"
      class="btn btn-sm rounded-xl font-bold transition-all btn-ghost text-base-content/70 hover:text-base-content"
      aria-selected="false"
      aria-controls="tab-content-uses"
    >
      <span>Uses</span>
    </button>
  </div>
</div>

<script>
  var isTicking = false;
  function updateTabsPosition() {
    var tabs = document.getElementById('about-floating-tabs');
    var footer = document.querySelector('footer');
    if (!tabs || !footer) return;

    var footerRect = footer.getBoundingClientRect();
    var viewportHeight = window.innerHeight;
    var defaultBottom = 24;

    var footerOverlap = viewportHeight - footerRect.top;
    if (footerOverlap > 0) {
      tabs.style.bottom = (defaultBottom + footerOverlap) + 'px';
    } else {
      tabs.style.bottom = defaultBottom + 'px';
    }
  }

  function handleScrollOrResize() {
    if (!isTicking) {
      window.requestAnimationFrame(function() {
        updateTabsPosition();
        isTicking = false;
      });
      isTicking = true;
    }
  }

  window.addEventListener('scroll', handleScrollOrResize, { passive: true });
  window.addEventListener('resize', handleScrollOrResize, { passive: true });

  function setActiveTab(tab, shouldScroll) {
    var meContent = document.getElementById('tab-content-me');
    var expContent = document.getElementById('tab-content-exp');
    var usesContent = document.getElementById('tab-content-uses');
    var meBtn = document.getElementById('tab-btn-me');
    var expBtn = document.getElementById('tab-btn-exp');
    var usesBtn = document.getElementById('tab-btn-uses');

    if (!meContent || !expContent || !usesContent || !meBtn || !expBtn || !usesBtn) return;

    // Reset all tabs to hidden and ghost styling
    meContent.classList.add('hidden');
    expContent.classList.add('hidden');
    usesContent.classList.add('hidden');

    meBtn.classList.remove('btn-primary', 'shadow-xs');
    meBtn.classList.add('btn-ghost', 'text-base-content/70');
    meBtn.setAttribute('aria-selected', 'false');

    expBtn.classList.remove('btn-primary', 'shadow-xs');
    expBtn.classList.add('btn-ghost', 'text-base-content/70');
    expBtn.setAttribute('aria-selected', 'false');

    usesBtn.classList.remove('btn-primary', 'shadow-xs');
    usesBtn.classList.add('btn-ghost', 'text-base-content/70');
    usesBtn.setAttribute('aria-selected', 'false');

    if (tab === 'exp') {
      expContent.classList.remove('hidden');
      expBtn.classList.remove('btn-ghost', 'text-base-content/70');
      expBtn.classList.add('btn-primary', 'shadow-xs');
      expBtn.setAttribute('aria-selected', 'true');
      if (window.location.hash !== '#experience' && window.location.hash !== '#training') {
        history.replaceState(null, '', '#experience');
      }
    } else if (tab === 'uses') {
      usesContent.classList.remove('hidden');
      usesBtn.classList.remove('btn-ghost', 'text-base-content/70');
      usesBtn.classList.add('btn-primary', 'shadow-xs');
      usesBtn.setAttribute('aria-selected', 'true');
      if (window.location.hash !== '#uses' && window.location.hash !== '#workstation') {
        history.replaceState(null, '', '#uses');
      }
    } else {
      meContent.classList.remove('hidden');
      meBtn.classList.remove('btn-ghost', 'text-base-content/70');
      meBtn.classList.add('btn-primary', 'shadow-xs');
      meBtn.setAttribute('aria-selected', 'true');
      if (window.location.hash === '#experience' || window.location.hash === '#uses' || window.location.hash === '#workstation') {
        history.replaceState(null, '', window.location.pathname);
      }
    }

    if (shouldScroll && window.scrollY > 120) {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Recalculate position as content height may have changed
    setTimeout(updateTabsPosition, 50);
  }

  function checkUrlForTab() {
    var hash = window.location.hash;
    var urlParams = new URLSearchParams(window.location.search);
    if (hash === '#experience' || hash === '#training' || urlParams.get('tab') === 'experience') {
      setActiveTab('exp');
    } else if (hash === '#uses' || hash === '#workstation' || urlParams.get('tab') === 'uses') {
      setActiveTab('uses');
    } else {
      setActiveTab('me');
    }
    updateTabsPosition();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', checkUrlForTab);
  } else {
    checkUrlForTab();
  }
  window.addEventListener('hashchange', checkUrlForTab);
</script>
