---
layout: layouts/base.njk

---

{% from "components/page-header.njk" import pageHeader %}
{% from "components/project-card.njk" import projectCard %}

<div class="max-w-6xl mx-auto px-4 py-12 sm:px-6">
  <!-- Reusable Page Header Component -->
  {{
    pageHeader(
      title=headerTitle or "Selected Projects & Engineering Work",
      description=headerDescription or "A collection of full-stack web applications, distributed systems projects, and developer tools built throughout my college capstones, internships, and open-source exploration.",
      badgeText=badgeText,
      badgeType="primary"
    )
  }}

  <!-- Category Tabs -->
  {% if collections.project and collections.project.length > 0 %}
    <div class="flex justify-start mb-8">
      <div
        class="inline-flex flex-wrap p-1.5 rounded-2xl frosted-glass gap-1.5 shadow-xs"
        role="tablist"
        aria-label="Filter projects by category"
        id="project-filters"
      >
        <button
          type="button"
          role="tab"
          aria-selected="true"
          class="btn btn-sm rounded-xl font-bold transition-all btn-primary shadow-xs filter-btn active"
          data-filter="all"
        >
          <span>All</span>
        </button>
        <button
          type="button"
          role="tab"
          aria-selected="false"
          class="btn btn-sm rounded-xl font-bold transition-all btn-ghost text-base-content/70 hover:text-base-content filter-btn"
          data-filter="Full Stack"
        >
          <span>Full Stack</span>
        </button>
        <button
          type="button"
          role="tab"
          aria-selected="false"
          class="btn btn-sm rounded-xl font-bold transition-all btn-ghost text-base-content/70 hover:text-base-content filter-btn"
          data-filter="Frontend"
        >
          <span>Frontend</span>
        </button>
        <button
          type="button"
          role="tab"
          aria-selected="false"
          class="btn btn-sm rounded-xl font-bold transition-all btn-ghost text-base-content/70 hover:text-base-content filter-btn"
          data-filter="Cloud & DevOps"
        >
          <span>Cloud & DevOps</span>
        </button>
        <button
          type="button"
          role="tab"
          aria-selected="false"
          class="btn btn-sm rounded-xl font-bold transition-all btn-ghost text-base-content/70 hover:text-base-content filter-btn"
          data-filter="Systems"
        >
          <span>Systems</span>
        </button>
      </div>
    </div>
  {% endif %}

  <!-- Projects List using DaisyUI List Component -->
  {% if collections.project and collections.project.length > 0 %}
    <ul
      class="list bg-base-100 rounded-none border border-base-200 shadow-sm overflow-hidden"
      id="projects-list"
    >
      {% for project in collections.project %}
        {{ projectCard(project) }}
      {% endfor %}
    </ul>

    <!-- Empty category feedback if zero projects match filter -->
    <div
      id="no-category-projects"
      class="hidden card bg-base-100 border border-base-200 p-8 sm:p-12 text-center rounded-3xl max-w-xl mx-auto my-6 space-y-3"
    >
      <div class="size-12 rounded-2xl bg-base-200 text-base-content/40 mx-auto flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
        </svg>
      </div>
      <div>
        <h3 class="text-xl font-bold text-base-content">No projects found</h3>
        <p class="text-sm text-base-content/60 mt-1">
          No projects found in this category yet. Select another tab above!
        </p>
      </div>
    </div>
  {% else %}
    <div class="card bg-base-100 border border-base-200 p-10 sm:p-16 text-center rounded-3xl max-w-xl mx-auto my-6 space-y-4">
      <div class="w-16 h-16 rounded-2xl bg-base-200 text-base-content/40 mx-auto flex items-center justify-center">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-8 h-8"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
          />
        </svg>
      </div>
      <div>
        <h3 class="text-2xl font-bold text-base-content">
          Nothing here for now
        </h3>
        <p class="text-sm text-base-content/60 mt-1.5 max-w-sm mx-auto">
          No projects have been added yet. Please check back later!
        </p>
      </div>
      <div class="pt-2 flex flex-wrap justify-center gap-3">
        <a
          href="{{ site.social.github or 'https://github.com/MillenniumParag' }}"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline btn-sm rounded-xl font-bold"
        >
          Visit GitHub (MillenniumParag) ↗
        </a>
        <a href="/resume/" class="btn btn-primary btn-sm rounded-xl font-bold">
          View Resume / CV →
        </a>
      </div>
    </div>
  {% endif %}
</div>

<!-- Interactive Filtering Script -->
<script>
document.addEventListener("DOMContentLoaded", () => {
  const filterButtons = document.querySelectorAll(".filter-btn");
  const cards = document.querySelectorAll(".project-card");
  const emptyCategoryState = document.getElementById("no-category-projects");
  const projectsList = document.getElementById("projects-list");

  filterButtons.forEach(btn => {
    btn.addEventListener("click", () => {
      filterButtons.forEach(b => {
        b.classList.remove("btn-primary", "active", "shadow-xs");
        b.classList.add("btn-ghost", "text-base-content/70");
        b.setAttribute("aria-selected", "false");
      });
      btn.classList.add("btn-primary", "active", "shadow-xs");
      btn.classList.remove("btn-ghost", "text-base-content/70");
      btn.setAttribute("aria-selected", "true");

      const selectedFilter = btn.getAttribute("data-filter");
      let visibleCount = 0;
      cards.forEach(card => {
        const category = card.getAttribute("data-category");
        if (selectedFilter === "all" || category === selectedFilter) {
          card.classList.remove("hidden");
          visibleCount++;
        } else {
          card.classList.add("hidden");
        }
      });

      if (emptyCategoryState && projectsList) {
        if (visibleCount === 0) {
          emptyCategoryState.classList.remove("hidden");
          projectsList.classList.add("hidden");
        } else {
          emptyCategoryState.classList.add("hidden");
          projectsList.classList.remove("hidden");
        }
      }
    });
  });
});
</script>
