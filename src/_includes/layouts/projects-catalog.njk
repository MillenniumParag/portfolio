---
layout: layouts/base.njk

---

{% from "components/page-header.njk" import pageHeader %}
{% from "components/project-card.njk" import projectCard %}

<div class="max-w-6xl mx-auto px-4 py-12 sm:px-6">
  <!-- Reusable Page Header Component -->
  {{
    pageHeader(
      title=headerTitle or "Selected Projects & Engineering Work",
      description=headerDescription or "A collection of full-stack web applications, distributed systems projects, and developer tools built throughout my college capstones, internships, and open-source exploration.",
      badgeText=badgeText,
      badgeType="primary"
    )
  }}

  <!-- Category Tabs -->
  {% if collections.project and collections.project.length > 0 %}
    <div class="flex justify-start mb-8">
      <div
        class="relative inline-flex flex-wrap p-1.5 rounded-xl frosted-glass border border-base-200/80 gap-1 shadow-xs"
        role="tablist"
        aria-label="Filter projects by category"
        id="project-filters"
      >
        <!-- Sliding Fill Indicator -->
        <div
          id="project-filter-indicator"
          class="absolute rounded-lg bg-primary pointer-events-none transition-all duration-300 ease-[cubic-bezier(0.25,1,0.5,1)] z-0 shadow-xs opacity-0"
        ></div>

        <button
          type="button"
          role="tab"
          aria-selected="true"
          class="relative z-10 btn btn-sm rounded-lg font-bold border-none bg-transparent hover:bg-transparent filter-btn active text-primary-content transition-colors duration-200"
          data-filter="all"
        >
          <span>All</span>
        </button>
        <button
          type="button"
          role="tab"
          aria-selected="false"
          class="relative z-10 btn btn-sm rounded-lg font-bold border-none bg-transparent hover:bg-transparent filter-btn text-base-content/70 hover:text-base-content transition-colors duration-200"
          data-filter="Full Stack"
        >
          <span>Full Stack</span>
        </button>
        <button
          type="button"
          role="tab"
          aria-selected="false"
          class="relative z-10 btn btn-sm rounded-lg font-bold border-none bg-transparent hover:bg-transparent filter-btn text-base-content/70 hover:text-base-content transition-colors duration-200"
          data-filter="Frontend"
        >
          <span>Frontend</span>
        </button>
        <button
          type="button"
          role="tab"
          aria-selected="false"
          class="relative z-10 btn btn-sm rounded-lg font-bold border-none bg-transparent hover:bg-transparent filter-btn text-base-content/70 hover:text-base-content transition-colors duration-200"
          data-filter="Cloud & DevOps"
        >
          <span>Cloud & DevOps</span>
        </button>
        <button
          type="button"
          role="tab"
          aria-selected="false"
          class="relative z-10 btn btn-sm rounded-lg font-bold border-none bg-transparent hover:bg-transparent filter-btn text-base-content/70 hover:text-base-content transition-colors duration-200"
          data-filter="Systems"
        >
          <span>Systems</span>
        </button>
      </div>
    </div>
  {% endif %}

  <!-- Projects List using DaisyUI List Component -->
  {% if collections.project and collections.project.length > 0 %}
    <ul
      class="list bg-base-100 border-t border-base-200"
      id="projects-list"
    >
      {% for project in collections.project %}
        {{ projectCard(project) }}
      {% endfor %}
    </ul>

    <!-- Empty category feedback if zero projects match filter -->
    <div
      id="no-category-projects"
      class="hidden py-16 text-center"
    >
      <p class="text-base sm:text-lg text-base-content/60 font-medium">Nothing here for now</p>
    </div>
  {% else %}
    <div class="py-24 text-center">
      <p class="text-base sm:text-lg text-base-content/60 font-medium">Nothing here for now</p>
    </div>
  {% endif %}
</div>

<!-- Interactive Filtering Script with Sliding Indicator -->
<script>
document.addEventListener("DOMContentLoaded", () => {
  const filterButtons = document.querySelectorAll(".filter-btn");
  const cards = document.querySelectorAll(".project-card");
  const emptyCategoryState = document.getElementById("no-category-projects");
  const projectsList = document.getElementById("projects-list");
  const indicator = document.getElementById("project-filter-indicator");

  function updateProjectIndicator(activeBtn, isInitial) {
    if (!indicator || !activeBtn) return;
    if (isInitial) {
      indicator.style.transition = "none";
    } else {
      indicator.style.transition = "all 300ms cubic-bezier(0.25, 1, 0.5, 1)";
    }
    indicator.style.left = activeBtn.offsetLeft + "px";
    indicator.style.top = activeBtn.offsetTop + "px";
    indicator.style.width = activeBtn.offsetWidth + "px";
    indicator.style.height = activeBtn.offsetHeight + "px";
    indicator.style.opacity = "1";
  }

  filterButtons.forEach(btn => {
    btn.addEventListener("click", () => {
      filterButtons.forEach(b => {
        b.classList.remove("active", "text-primary-content");
        b.classList.add("text-base-content/70");
        b.setAttribute("aria-selected", "false");
      });
      btn.classList.add("active", "text-primary-content");
      btn.classList.remove("text-base-content/70");
      btn.setAttribute("aria-selected", "true");
      updateProjectIndicator(btn, false);

      const selectedFilter = btn.getAttribute("data-filter");
      let visibleCount = 0;
      cards.forEach(card => {
        const category = card.getAttribute("data-category");
        if (selectedFilter === "all" || category === selectedFilter) {
          card.classList.remove("hidden");
          visibleCount++;
        } else {
          card.classList.add("hidden");
        }
      });

      if (emptyCategoryState && projectsList) {
        if (visibleCount === 0) {
          emptyCategoryState.classList.remove("hidden");
          projectsList.classList.add("hidden");
        } else {
          emptyCategoryState.classList.add("hidden");
          projectsList.classList.remove("hidden");
        }
      }
    });
  });

  const initialActive = document.querySelector(".filter-btn.active") || filterButtons[0];
  if (initialActive) {
    requestAnimationFrame(() => updateProjectIndicator(initialActive, true));
  }

  window.addEventListener("resize", () => {
    const currentActive = document.querySelector(".filter-btn.active");
    if (currentActive) updateProjectIndicator(currentActive, true);
  });
});
</script>
