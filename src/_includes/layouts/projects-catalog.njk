---
layout: layouts/base.njk
---

{% from "components/page-header.njk" import pageHeader %}
{% from "components/project-card.njk" import projectCard %}
{% from "components/cta-banner.njk" import ctaBanner %}

<div class="max-w-6xl mx-auto px-4 py-12 sm:px-6">
  <!-- Reusable Page Header Component -->
  {{ pageHeader(
    title=headerTitle or "Selected Projects & Engineering Work",
    description=headerDescription or "A collection of full-stack web applications, distributed systems projects, and developer tools built throughout my college capstones, internships, and open-source exploration.",
    badgeText=badgeText or ("Project Showcase • " + (collections.project.length or 4) + " Case Studies"),
    badgeType="primary"
  ) }}

  <!-- Filter Pills using daisyUI btn components -->
  {% if collections.project and collections.project.length > 0 %}
  <div class="flex flex-wrap items-center gap-2 mb-10 pb-4 border-b border-base-200" id="project-filters">
    <button class="btn btn-sm btn-primary rounded-xl filter-btn active" data-filter="all">All Projects</button>
    <button class="btn btn-sm btn-ghost rounded-xl filter-btn" data-filter="Full Stack">Full Stack</button>
    <button class="btn btn-sm btn-ghost rounded-xl filter-btn" data-filter="Frontend">Frontend</button>
    <button class="btn btn-sm btn-ghost rounded-xl filter-btn" data-filter="AI & DevOps">AI & DevOps</button>
    <button class="btn btn-sm btn-ghost rounded-xl filter-btn" data-filter="Systems">Systems</button>
  </div>
  {% endif %}

  <!-- Projects Grid using Reusable Project Card Component -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8" id="projects-grid">
    {% if collections.project and collections.project.length > 0 %}
      {% for project in collections.project %}
        {{ projectCard(project) }}
      {% endfor %}
    {% else %}
      <div class="col-span-full card bg-base-100 border border-base-200 p-8 sm:p-14 text-center rounded-3xl max-w-2xl mx-auto space-y-5">
        <div class="w-16 h-16 rounded-2xl bg-primary/10 text-primary mx-auto flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
          </svg>
        </div>
        <h3 class="text-2xl font-black text-base-content">Projects in Active Development</h3>
        <p class="text-sm text-base-content/75 leading-relaxed">
          I am currently building full-stack applications with Java, Spring Boot, React, Angular, and cloud pipelining on AWS. As new repositories and live demos are deployed, they will be documented here with architecture breakdowns.
        </p>
        <div class="pt-2 flex flex-wrap justify-center gap-3">
          <a href="{{ site.social.github or 'https://github.com/MillenniumParag' }}" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm rounded-xl gap-2 font-bold">
            <span>Visit GitHub (MillenniumParag) ↗</span>
          </a>
          <a href="{{ site.social.linkedin or 'https://www.linkedin.com/in/chatterjeeparag/' }}" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm rounded-xl font-bold">
            <span>Connect on LinkedIn ↗</span>
          </a>
        </div>
      </div>
    {% endif %}
  </div>

  <!-- Reusable Call To Action Banner Component -->
  <div class="mt-16">
    {{ ctaBanner(
      title=cta.title or "Looking for an ambitious, fast-learning developer?",
      subtitle=cta.subtitle or "I am actively looking for software engineering internships and junior developer roles. Let's connect!",
      buttonText=cta.buttonText or "Connect on LinkedIn →",
      buttonUrl=cta.buttonUrl or "https://www.linkedin.com/in/chatterjeeparag/"
    ) }}
  </div>
</div>

<!-- Interactive Filtering Script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.project-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => {
          b.classList.remove('btn-primary', 'active');
          b.classList.add('btn-ghost');
        });
        btn.classList.add('btn-primary', 'active');
        btn.classList.remove('btn-ghost');

        const selectedFilter = btn.getAttribute('data-filter');
        cards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (selectedFilter === 'all' || category === selectedFilter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  });
</script>
