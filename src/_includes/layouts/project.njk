---
layout: layouts/base.njk

---

<article class="max-w-6xl mx-auto px-4 py-12 sm:px-6">
  <!-- Back button -->
  <div class="mb-8">
    <a
      href="/projects/"
      class="btn btn-ghost btn-sm gap-2 pl-0 hover:bg-transparent text-primary mb-4 inline-flex items-center"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M10 19l-7-7m0 0l7-7m-7 7h18"
        />
      </svg>
      Back to all projects
    </a>

    <!-- Category & Status Badges -->
    <div class="flex flex-wrap items-center gap-2 mb-3">
      {% if category %}
        <span
          class="badge badge-primary font-bold uppercase tracking-wider text-xs"
        >{{ category }}</span>
      {% endif %}
      {% if year %}
        <span class="badge badge-ghost font-mono text-xs">{{ year }}</span>
      {% endif %}
      {% if featured %}
        <span class="badge badge-accent badge-outline text-xs"
        >Featured Project</span>
      {% endif %}
    </div>

    <!-- Title -->
    <h1 class="text-3xl sm:text-5xl font-black tracking-tight mb-4 text-base-content leading-tight">
      {{ title }}
    </h1>

    {% if description %}
      <p class="text-base sm:text-lg text-base-content/75 mb-6 leading-relaxed">
        {{ description }}
      </p>
    {% endif %}

    <!-- Action Links & Tech Summary -->
    <div class="flex flex-wrap items-center justify-between gap-4 py-6 border-y border-base-200">
      <div class="flex flex-wrap gap-3">
        {% if demoUrl %}
          <a
            href="{{ demoUrl }}"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary btn-sm rounded-lg gap-2 font-bold"
          >
            <span>Live Demo</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              />
            </svg>
          </a>
        {% endif %}
        {% if githubUrl %}
          <a
            href="{{ githubUrl }}"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline btn-sm rounded-lg gap-2"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
            </svg>
            <span>Source Code</span>
          </a>
        {% endif %}
      </div>

      <div class="flex flex-wrap gap-1.5">
        {% for tech in techStack %}
          <span class="badge badge-sm badge-ghost font-mono">{{ tech }}</span>
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- Showcase Mockup Window Banner Container -->
  {% if image %}
    <div class="mb-12 mockup-window border border-base-300 bg-base-200/50 rounded-xl overflow-hidden shadow-none">
      <div class="relative w-full aspect-video bg-base-200">
        <img
          src="{{ image }}"
          alt="{{ title }} Preview"
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>
    </div>
  {% else %}
    <div class="mb-12 mockup-window border border-base-300 bg-base-200/50 rounded-xl overflow-hidden shadow-none">
      <div class="w-full aspect-video bg-linear-to-br from-base-200 via-base-300 to-base-200 flex flex-col justify-center items-center p-8 text-center">
        <h3 class="text-3xl font-black text-base-content/80">{{ title }}</h3>
        <p class="text-sm text-base-content/60 mt-2 font-mono">
          Interactive Case Study
        </p>
      </div>
    </div>
  {% endif %}

  <!-- Case study markdown content -->
  <div class="prose prose-lg max-w-none text-base-content leading-relaxed space-y-6">
    {{ content | safe }}
  </div>

  <!-- Navigation / Footer -->
  <div class="mt-16 pt-8 border-t border-base-200 flex flex-wrap justify-between items-center gap-4">
    <a href="/projects/" class="btn btn-outline btn-sm rounded-lg font-medium group inline-flex items-center gap-1.5">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 transition-transform duration-200 group-hover:-translate-x-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      <span>Back to All Projects</span>
    </a>
    <div class="flex items-center gap-3">
      <a href="{{ site.social.linkedin or 'https://www.linkedin.com/in/chatterjeeparag/' }}" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm rounded-lg font-bold group inline-flex items-center gap-1.5">
        <span>Discuss on LinkedIn</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
        </svg>
      </a>
    </div>
  </div>
</article>
