---
layout: layouts/base.njk

---

{% from "components/project-card.njk" import projectCard %}
{% from "components/article-card.njk" import articleCard %}
{% from "components/cta-banner.njk" import ctaBanner %}

<!-- Hero Section -->
<section class="relative overflow-hidden py-16 sm:py-24 bg-linear-to-b from-base-200/40 via-base-100 to-base-100 border-b border-base-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Content -->
      <div class="lg:col-span-8 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 text-primary font-bold text-xs">
          <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
          <span>{{
            hero.badge or "BCA (Hons) 4 Years (Class of 2026) • Aspiring Full Stack Engineer"
          }}</span>
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-base-content leading-[1.08]">
          {{
            hero.headline or "Bridging solid CS fundamentals with production-ready software."
          }}
        </h1>

        <p class="text-lg sm:text-xl text-base-content/75 max-w-2xl leading-relaxed">
          {{
            hero.bio or "Hi, I'm Parag Chatterjee. I'm a BCA (Hons) 4 Years graduate passionate about building responsive web applications, robust backend APIs, and developer tools using TypeScript, Next.js, Go, and PostgreSQL. Excited to bring high energy and relentless curiosity to an engineering team."
          }}
        </p>

        <!-- Call to Actions -->
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a
            href="{{ hero.primaryButtonUrl or '/projects/' }}"
            class="btn btn-primary rounded-xl px-7 text-base font-bold"
          >
            {{ hero.primaryButtonText or "Explore Projects →" }}
          </a>
          <a
            href="{{ hero.secondaryButtonUrl or 'https://www.linkedin.com/in/chatterjeeparag/' }}"
            {% if (hero.secondaryButtonUrl or 'https://www.linkedin.com/in/chatterjeeparag/') | startsWith('http') %}target="_blank" rel="noopener noreferrer"{% endif %}
            class="btn btn-outline rounded-xl px-7 text-base"
          >
            {{ hero.secondaryButtonText or "Connect on LinkedIn ↗" }}
          </a>
          <a
            href="{{ hero.cvButtonUrl or '/resume/' }}"
            class="btn btn-ghost rounded-xl px-4 text-base-content/70 hover:text-primary"
          >
            {{ hero.cvButtonText or "View Resume / CV" }}
          </a>
        </div>

        <!-- Metric Badges using daisyUI stats -->
        <div class="grid grid-cols-3 gap-4 pt-6 max-w-lg border-t border-base-200 text-left">
          {% for stat in stats %}
            <div>
              <div class="text-2xl sm:text-3xl font-black text-{{ stat.color or 'primary' }}">
                {{ stat.value }}
              </div>
              <div class="text-xs text-base-content/60 font-medium">
                {{ stat.label }}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      <!-- Simple Hero Image (Updatable via Decap CMS Admin) -->
      <div class="lg:col-span-4 flex justify-center">
        <div class="w-full max-w-sm">
          <div class="overflow-hidden rounded-3xl border border-base-200 shadow-xl bg-base-200 aspect-4/5">
            <img
              src="{{ hero.image or '/uploads/avatar.jpg' }}"
              alt="{{ hero.imageAlt or 'Parag Chatterjee' }}"
              class="w-full h-full object-cover object-center"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Featured Projects Preview Section -->
<section class="max-w-6xl mx-auto px-4 sm:px-6 py-20">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12">
    <div>
      <div class="text-xs uppercase font-bold tracking-widest text-primary mb-2">
        {{ projectsSectionSubtitle or "Portfolio Showcase" }}
      </div>
      <h2 class="text-3xl sm:text-5xl font-black tracking-tight">
        {{ projectsSectionTitle or "Featured Engineering & Practice" }}
      </h2>
    </div>
    <a href="/projects/" class="btn btn-outline rounded-xl font-bold">
      View Projects & Repositories →
    </a>
  </div>

  {% if collections.project and collections.project.length > 0 %}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {% for project in collections.project | limit(3) %}
        {{ projectCard(project) }}
      {% endfor %}
    </div>
  {% else %}
    <div class="card bg-base-100 border border-base-200 p-8 sm:p-12 text-center rounded-3xl max-w-3xl mx-auto space-y-4">
      <div class="w-14 h-14 rounded-2xl bg-primary/10 text-primary mx-auto flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
        </svg>
      </div>
      <h3 class="text-2xl font-black text-base-content">Projects in Active Development</h3>
      <p class="text-sm text-base-content/75 leading-relaxed max-w-xl mx-auto">
        Currently architecting and building applications with Spring Boot, Java, React, Angular, and AWS. Check out active work and repositories on GitHub.
      </p>
      <div class="pt-2 flex flex-wrap justify-center gap-3">
        <a href="{{ site.social.github or 'https://github.com/MillenniumParag' }}" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm rounded-xl font-bold">
          Follow on GitHub (MillenniumParag) ↗
        </a>
        <a href="/experience/" class="btn btn-outline btn-sm rounded-xl font-bold">
          View Practical Training & Experience →
        </a>
      </div>
    </div>
  {% endif %}
</section>

<!-- Core Engineering Pillars -->
<section class="bg-base-200/50 py-20 border-y border-base-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="text-xs uppercase font-bold tracking-widest text-secondary mb-2">
        Technical Capabilities
      </div>
      <h2 class="text-3xl sm:text-4xl font-black tracking-tight">
        Areas of Core Competence
      </h2>
      <p class="text-sm text-base-content/70 mt-2">
        Specialized in the full lifecycle of modern digital products.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {% for pillar in pillars %}
        <div class="card bg-base-100 border border-base-200 p-8 rounded-3xl">
          <div class="w-12 h-12 rounded-2xl bg-primary/10 text-primary flex items-center justify-center text-2xl font-black mb-6">
            {{ pillar.icon }}
          </div>
          <h3 class="text-xl font-black mb-3">{{ pillar.title }}</h3>
          <p class="text-sm text-base-content/75 leading-relaxed mb-6">
            {{ pillar.description }}
          </p>
          <div class="flex flex-wrap gap-1.5 text-xs font-mono">
            {% for tag in pillar.tags %}
              <span class="badge badge-sm badge-ghost">{{ tag }}</span>
            {% endfor %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- Latest Articles Preview -->
<section class="max-w-6xl mx-auto px-4 sm:px-6 py-20">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12">
    <div>
      <div class="text-xs uppercase font-bold tracking-widest text-accent mb-2">
        {{ blogSectionSubtitle or "Writing & Tutorials" }}
      </div>
      <h2 class="text-3xl sm:text-5xl font-black tracking-tight">
        {{ blogSectionTitle or "Recent Thoughts" }}
      </h2>
    </div>
    <a href="/blog/" class="btn btn-outline rounded-xl font-bold">
      Read All Articles →
    </a>
  </div>

  {% if collections.post and collections.post.length > 0 %}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {% for post in collections.post | reverse | limit(2) %}
        {{ articleCard(post) }}
      {% endfor %}
    </div>
  {% else %}
    <div class="card bg-base-100 border border-base-200 p-8 sm:p-12 text-center rounded-3xl max-w-3xl mx-auto space-y-4">
      <div class="w-14 h-14 rounded-2xl bg-accent/10 text-accent mx-auto flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
        </svg>
      </div>
      <h3 class="text-2xl font-black text-base-content">Articles & Insights Coming Soon</h3>
      <p class="text-sm text-base-content/75 leading-relaxed max-w-xl mx-auto">
        Technical articles on full-stack development, Java, Spring Boot, and cloud concepts will appear here as Parag publishes them.
      </p>
      <div class="pt-2 flex flex-wrap justify-center gap-3">
        <a href="/admin/#/collections/posts/new" target="_blank" class="btn btn-primary btn-sm rounded-xl font-bold">
          + Add New Article in Decap CMS
        </a>
      </div>
    </div>
  {% endif %}
</section>

<!-- Call to Action Banner -->
<section class="max-w-6xl mx-auto px-4 sm:px-6 mb-20">
  {{
    ctaBanner(
      title=cta.title or "Interested in connecting or discussing engineering opportunities?",
      subtitle=cta.subtitle or "I am actively seeking software engineering internships and junior developer opportunities. Let's connect on LinkedIn!",
      buttonText=cta.buttonText or "Connect on LinkedIn →",
      buttonUrl=cta.buttonUrl or "https://www.linkedin.com/in/chatterjeeparag/",
      secondaryText=cta.secondaryText or "View GitHub Profile",
      secondaryUrl=cta.secondaryUrl or "https://github.com/MillenniumParag"
    )
  }}
</section>
