---
layout: layouts/base.njk

---

{% from "components/project-card.njk" import projectCard %}
{% from "components/article-card.njk" import articleCard %}
{% from "components/cta-banner.njk" import ctaBanner %}

<!-- Hero Section -->
<section class="relative overflow-hidden py-16 sm:py-24 bg-linear-to-b from-base-200/40 via-base-100 to-base-100 border-b border-base-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Content -->
      <div class="lg:col-span-8 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 text-primary font-bold text-xs">
          <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
          <span>{{
            hero.badge or "BCA (Hons) 4 Years (Class of 2026) • Aspiring Full Stack Engineer"
          }}</span>
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-base-content leading-[1.08]">
          {{
            hero.headline or "Bridging solid CS fundamentals with production-ready software."
          }}
        </h1>

        <p class="text-lg sm:text-xl text-base-content/75 max-w-2xl leading-relaxed">
          {{
            hero.bio or "Hi, I'm Parag Chatterjee. I am a BCA (Hons) 4 Years student at Techno India (Hooghly Campus) affiliated to MAKAUT University, based in Janai, Hooghly. Skilled in Java, Spring Boot, React, Angular, C, Python 3, and AWS Cloud."
          }}
        </p>

        <!-- Call to Actions -->
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a
            href="{{ hero.primaryButtonUrl or '/projects/' }}"
            class="btn btn-primary rounded-xl px-7 text-base font-bold"
          >
            {{ hero.primaryButtonText or "Explore Portfolio →" }}
          </a>
          {% if hero.secondaryButtonText %}
          <a
            href="{{ hero.secondaryButtonUrl or '/about/' }}"
            {% if (hero.secondaryButtonUrl) | startsWith('http') %}target="_blank" rel="noopener noreferrer"{% endif %}
            class="btn btn-outline rounded-xl px-7 text-base"
          >
            {{ hero.secondaryButtonText }}
          </a>
          {% endif %}
          <a
            href="{{ hero.cvButtonUrl or '/resume/' }}"
            class="btn btn-ghost rounded-xl px-4 text-base-content/70 hover:text-primary font-semibold"
          >
            {{ hero.cvButtonText or "View Resume / CV" }}
          </a>
        </div>

        <!-- Metric Badges -->
        <div class="flex flex-wrap items-center gap-8 sm:gap-12 pt-6 max-w-lg border-t border-base-200 text-left">
          {% for stat in stats %}
            <div>
              <div class="text-2xl sm:text-3xl font-black text-{{ stat.color or 'primary' }}">
                {{ stat.value }}
              </div>
              <div class="text-xs text-base-content/60 font-medium mt-0.5">
                {{ stat.label }}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      <!-- Simple Hero Image (Updatable via Decap CMS Admin) -->
      <div class="lg:col-span-4 flex justify-center">
        <div class="w-full max-w-sm">
          <div class="relative overflow-hidden rounded-3xl border border-base-200 shadow-2xl shadow-primary/10 bg-base-200 aspect-4/5 group">
            <img
              src="{{ hero.image or '/uploads/avatar.jpg' }}"
              alt="{{ hero.imageAlt or 'Parag Chatterjee' }}"
              class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
              loading="eager"
              onerror="this.onerror=null; this.src='/uploads/avatar.jpg';"
            />
            <div class="absolute inset-0 ring-1 ring-inset ring-base-content/10 rounded-3xl pointer-events-none"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Featured Projects Preview Section -->
<section class="max-w-6xl mx-auto px-4 sm:px-6 py-20">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12">
    <div>
      <div class="text-xs uppercase font-bold tracking-widest text-primary mb-2">
        {{ projectsSectionSubtitle or "Portfolio Showcase" }}
      </div>
      <h2 class="text-3xl sm:text-5xl font-black tracking-tight">
        {{ projectsSectionTitle or "Featured Engineering & Practice" }}
      </h2>
    </div>
    <a href="/projects/" class="btn btn-outline rounded-xl font-bold">
      View Projects & Repositories →
    </a>
  </div>

  {% if collections.project and collections.project.length > 0 %}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {% for project in collections.project | limit(3) %}
        {{ projectCard(project) }}
      {% endfor %}
    </div>
  {% else %}
    <div class="card bg-base-100 border border-base-200 p-8 sm:p-14 text-center rounded-3xl max-w-2xl mx-auto space-y-4">
      <div class="w-14 h-14 rounded-2xl bg-base-200 text-base-content/40 mx-auto flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
        </svg>
      </div>
      <div>
        <h3 class="text-2xl font-bold text-base-content">Nothing here for now</h3>
        <p class="text-sm text-base-content/60 mt-1.5 max-w-md mx-auto">
          Projects are currently being prepared. Check back soon!
        </p>
      </div>
      <div class="pt-1 flex flex-wrap justify-center gap-3">
        <a href="{{ site.social.github or 'https://github.com/MillenniumParag' }}" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm rounded-xl font-bold">
          Visit GitHub (MillenniumParag) ↗
        </a>
      </div>
    </div>
  {% endif %}
</section>

<!-- Core Engineering Pillars -->
<section class="bg-base-200/50 py-20 border-y border-base-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="text-xs uppercase font-bold tracking-widest text-secondary mb-2">
        Skills &amp; Knowledge
      </div>
      <h2 class="text-3xl sm:text-4xl font-black tracking-tight">
        What I Work With
      </h2>
      <p class="text-sm text-base-content/70 mt-2">
        Software development stack, programming languages, and engineering domains.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {% for pillar in pillars %}
        <div class="card bg-base-100 border border-base-200/80 p-8 rounded-3xl transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:shadow-xl group">
          <div class="w-12 h-12 rounded-2xl bg-primary/10 text-primary flex items-center justify-center mb-6 group-hover:bg-primary group-hover:text-primary-content transition-colors duration-300">
            {% if pillar.icon == "palette" %}
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
              </svg>
            {% elif pillar.icon == "server" %}
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
              </svg>
            {% elif pillar.icon == "cpu" %}
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 3v2m6-2v2M9 19v2m6-2v2M3 9h2m-2 6h2m14-6h2m-2 6h2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
              </svg>
            {% else %}
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
            {% endif %}
          </div>
          <h3 class="text-xl font-black mb-3">{{ pillar.title }}</h3>
          <p class="text-sm text-base-content/75 leading-relaxed mb-6">
            {{ pillar.description }}
          </p>
          <div class="flex flex-wrap gap-1.5 text-xs font-mono">
            {% for tag in pillar.tags %}
              <span class="badge badge-sm badge-ghost">{{ tag }}</span>
            {% endfor %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- Latest Articles Preview -->
<section class="max-w-6xl mx-auto px-4 sm:px-6 py-20">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12">
    <div>
      <div class="text-xs uppercase font-bold tracking-widest text-accent mb-2">
        {{ blogSectionSubtitle or "Writing & Tutorials" }}
      </div>
      <h2 class="text-3xl sm:text-5xl font-black tracking-tight">
        {{ blogSectionTitle or "Recent Thoughts" }}
      </h2>
    </div>
    <a href="/blog/" class="btn btn-outline rounded-xl font-bold">
      Read All Articles →
    </a>
  </div>

  {% if collections.post and collections.post.length > 0 %}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {% for post in collections.post | reverse | limit(2) %}
        {{ articleCard(post) }}
      {% endfor %}
    </div>
  {% else %}
    <div class="card bg-base-100 border border-base-200 p-8 sm:p-14 text-center rounded-3xl max-w-2xl mx-auto space-y-4">
      <div class="w-14 h-14 rounded-2xl bg-base-200 text-base-content/40 mx-auto flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
        </svg>
      </div>
      <div>
        <h3 class="text-2xl font-bold text-base-content">Nothing here for now</h3>
        <p class="text-sm text-base-content/60 mt-1.5 max-w-md mx-auto">
          Articles will be published soon. Stay tuned!
        </p>
      </div>
    </div>
  {% endif %}
</section>

<!-- Call to Action Banner -->
<section class="max-w-6xl mx-auto px-4 sm:px-6 mb-20">
  {{
    ctaBanner(
      title=cta.title or "Interested in discussing engineering opportunities?",
      subtitle=cta.subtitle or "Feel free to explore my portfolio or view my complete curriculum vitae.",
      buttonText=cta.buttonText or "View Resume / CV →",
      buttonUrl=cta.buttonUrl or "/resume/",
      secondaryText=cta.secondaryText or "Explore Portfolio",
      secondaryUrl=cta.secondaryUrl or "/projects/"
    )
  }}
</section>
