---
layout: layouts/base.njk

---

{% from "components/project-card.njk" import projectCard %}
{% from "components/article-card.njk" import articleCard %}

<!-- Hero Section -->
<section class="relative overflow-hidden py-16 sm:py-24 bg-linear-to-b from-base-200/40 via-base-100 to-base-100 border-b border-base-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Content -->
      <div class="lg:col-span-8 space-y-6">
        <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-base-content leading-tight">
          {{
            hero.headline or "Bridging solid CS fundamentals with production-ready software."
          }}
        </h1>

        <p class="text-base sm:text-lg text-base-content/75 max-w-2xl leading-relaxed">
          {{
            hero.bio or "Hi, I'm Parag Chatterjee. I am a BCA (Hons) 4 Years student at Techno India (Hooghly Campus) affiliated to MAKAUT University, based in Janai, Hooghly. Skilled in Java, Spring Boot, React, Angular, C, Python 3, and AWS Cloud."
          }}
        </p>

        <!-- Call to Actions -->
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a
            href="{{ hero.primaryButtonUrl or '/projects/' }}"
            class="btn btn-primary rounded-lg px-7 text-base font-bold"
          >
            {{ hero.primaryButtonText or "Explore Portfolio →" }}
          </a>
          {% if hero.secondaryButtonText %}
          <a
            href="{{ hero.secondaryButtonUrl or '/about/' }}"
            {% if (hero.secondaryButtonUrl) | startsWith('http') %}target="_blank" rel="noopener noreferrer"{% endif %}
            class="btn btn-outline rounded-lg px-7 text-base"
          >
            {{ hero.secondaryButtonText }}
          </a>
          {% endif %}
          <a
            href="{{ hero.cvButtonUrl or '/resume/' }}"
            class="btn btn-ghost rounded-lg px-4 text-base-content/70 hover:text-primary font-semibold"
          >
            {{ hero.cvButtonText or "View Resume / CV" }}
          </a>
        </div>

        <!-- Metric Badges -->
        <div class="flex flex-wrap items-center gap-8 sm:gap-12 pt-6 max-w-lg border-t border-base-200 text-left">
          {% for stat in stats %}
            <div>
              <div class="text-2xl sm:text-3xl font-black text-{{ stat.color or 'primary' }}">
                {{ stat.value }}
              </div>
              <div class="text-xs text-base-content/60 font-medium mt-0.5">
                {{ stat.label }}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      <!-- Simple Hero Image (Updatable via Decap CMS Admin) -->
      <div class="lg:col-span-4 flex justify-center">
        <div class="w-full max-w-sm">
          <div class="relative overflow-hidden rounded-xl border border-base-200 shadow-2xl shadow-primary/10 bg-base-200 aspect-4/5 group">
            <img
              src="{{ hero.image or '/uploads/me.avif' }}"
              alt="{{ hero.imageAlt or 'Parag Chatterjee' }}"
              class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
              loading="eager"
              onerror="this.onerror=null; this.src='/uploads/me.webp';"
            />
            <div class="absolute inset-0 ring-1 ring-inset ring-base-content/10 rounded-xl pointer-events-none"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Infinite Tech Stack Marquee (Languages, Libraries, Frameworks) -->
<section class="border-y border-base-200/80 bg-base-200/30 py-4 overflow-hidden relative">
  <!-- Progressive Blur Masks: Keeps scroll items blurry till the max-w-6xl bounds -->
  <div class="marquee-mask-left"></div>
  <div class="marquee-mask-right"></div>

  <div class="animate-marquee flex items-center gap-3 select-none">
    {% set techStack = [
      { name: "Java", category: "Language", icon: "/icons/tech/java.svg" },
      { name: "Spring Boot", category: "Framework", icon: "/icons/tech/spring.svg" },
      { name: "React", category: "Library", icon: "/icons/tech/react.svg" },
      { name: "Angular", category: "Framework", icon: "/icons/tech/angular.svg" },
      { name: "TypeScript", category: "Language", icon: "/icons/tech/typescript.svg" },
      { name: "C / DSA", category: "Core CS", icon: "/icons/tech/c.svg" },
      { name: "Python 3", category: "Language", icon: "/icons/tech/python.svg" },
      { name: "AWS Cloud", category: "Cloud", icon: "/icons/tech/aws.svg" },
      { name: "PostgreSQL", category: "Database", icon: "/icons/tech/postgresql.svg" },
      { name: "MySQL", category: "Database", icon: "/icons/tech/mysql.svg" },
      { name: "Oracle SQL Plus", category: "Database", icon: "/icons/tech/oracle.svg" },
      { name: "NeonDB", category: "Database", icon: "/icons/tech/neondb.svg" },
      { name: "TailwindCSS", category: "CSS", icon: "/icons/tech/tailwindcss.svg" },
      { name: "daisyUI", category: "UI", icon: "/icons/tech/daisyui.svg" },
      { name: "Linux / WSL", category: "Systems", icon: "/icons/tech/linux.svg" },
      { name: "Git / GitHub", category: "Tooling", icon: "/icons/tech/git.svg" },
      { name: "REST APIs", category: "Architecture", icon: "/icons/tech/restapi.svg" },
      { name: "Maven & Vite", category: "Build Tools", icon: "/icons/tech/vite.svg" },
      { name: "SAP ABAP", category: "Enterprise", icon: "/icons/tech/sap.svg" }
    ] %}

    <!-- Loop 1 -->
    {% for item in techStack %}
      <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-lg bg-base-100 border border-base-200 text-xs sm:text-sm font-semibold text-base-content/85 shadow-2xs hover:border-primary/50 hover:text-primary transition-all duration-200 whitespace-nowrap group">
        <img src="{{ item.icon }}" alt="{{ item.name }}" class="w-4 h-4 sm:w-4.5 sm:h-4.5 object-contain shrink-0 transition-transform duration-200 group-hover:scale-110" width="18" height="18" loading="lazy" />
        <span>{{ item.name }}</span>
        <span class="text-[10px] font-mono text-base-content/40 uppercase tracking-wider pl-1.5 border-l border-base-200">{{ item.category }}</span>
      </div>
    {% endfor %}

    <!-- Loop 2 (Mirror for seamless loop) -->
    {% for item in techStack %}
      <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-lg bg-base-100 border border-base-200 text-xs sm:text-sm font-semibold text-base-content/85 shadow-2xs hover:border-primary/50 hover:text-primary transition-all duration-200 whitespace-nowrap group">
        <img src="{{ item.icon }}" alt="{{ item.name }}" class="w-4 h-4 sm:w-4.5 sm:h-4.5 object-contain shrink-0 transition-transform duration-200 group-hover:scale-110" width="18" height="18" loading="lazy" />
        <span>{{ item.name }}</span>
        <span class="text-[10px] font-mono text-base-content/40 uppercase tracking-wider pl-1.5 border-l border-base-200">{{ item.category }}</span>
      </div>
    {% endfor %}
  </div>
</section>

<!-- Featured Projects Preview Section -->
<section class="max-w-6xl mx-auto px-4 sm:px-6 py-20">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12">
    <div>
      <h2 class="text-2xl sm:text-3xl font-black tracking-tight">
        {{ projectsSectionTitle or "Engineering & Practice" }}
      </h2>
    </div>
    <a href="/projects/" class="btn btn-outline rounded-lg font-bold">
      View Projects & Repositories →
    </a>
  </div>

  {% if collections.project and collections.project.length > 0 %}
    <ul class="list bg-base-100 border-t border-base-200">
      {% for project in collections.project | limit(4) %}
        {{ projectCard(project) }}
      {% endfor %}
    </ul>
  {% else %}
    <div class="py-16 text-center">
      <p class="text-base sm:text-lg text-base-content/60 font-medium">Nothing here for now</p>
    </div>
  {% endif %}
</section>

<!-- Core Engineering Pillars / What I Work With Carousel -->
<section class="bg-base-200/50 py-20 border-y border-base-300 overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Header with Section Title and Carousel Controls -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-12">
      <div class="max-w-2xl">
        <h2 class="text-2xl sm:text-3xl font-black tracking-tight">
          What I Work With
        </h2>
        <p class="text-sm text-base-content/70 mt-2">
          Software development stack, programming languages, and engineering domains.
        </p>
      </div>

      <!-- Navigation buttons -->
      <div class="flex items-center gap-3 self-start sm:self-end">
        <button
          id="pillars-prev"
          type="button"
          class="btn btn-circle btn-sm btn-ghost border border-base-300 hover:btn-primary hover:border-primary transition-all duration-200 shadow-xs"
          aria-label="Previous slide"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button
          id="pillars-next"
          type="button"
          class="btn btn-circle btn-sm btn-ghost border border-base-300 hover:btn-primary hover:border-primary transition-all duration-200 shadow-xs"
          aria-label="Next slide"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Carousel Track: 3 cards on desktop (lg), 2 on tablet (sm), 1 on mobile -->
    <div class="relative">
      <div
        id="pillars-carousel"
        data-lenis-prevent
        class="carousel w-full gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory py-4 no-scrollbar cursor-grab select-none"
        tabindex="0"
        role="region"
        aria-label="What I Work With Carousel"
      >
        {% for pillar in pillars %}
          <div class="carousel-item w-full sm:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)] flex-none snap-start">
            <div class="card bg-base-100 border border-base-200/80 p-7 sm:p-8 rounded-xl transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:shadow-xl group w-full flex flex-col justify-between h-full min-h-[340px]">
              <div>
                <div class="w-12 h-12 rounded-lg bg-primary/10 text-primary flex items-center justify-center mb-6 group-hover:bg-primary group-hover:text-primary-content transition-colors duration-300">
                  {% if pillar.icon == "palette" %}
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                    </svg>
                  {% elif pillar.icon == "server" %}
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
                    </svg>
                  {% elif pillar.icon == "cloud" %}
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 00-9.78 2.096A4.001 4.001 0 003 15z" />
                    </svg>
                  {% elif pillar.icon == "cpu" %}
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 3v2m6-2v2M9 19v2m6-2v2M3 9h2m-2 6h2m14-6h2m-2 6h2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
                    </svg>
                  {% elif pillar.icon == "database" %}
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
                    </svg>
                  {% elif pillar.icon == "terminal" %}
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                  {% else %}
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                    </svg>
                  {% endif %}
                </div>
                <h3 class="text-lg font-bold mb-2">{{ pillar.title }}</h3>
                <p class="text-sm text-base-content/75 leading-relaxed mb-6">
                  {{ pillar.description }}
                </p>
              </div>
              <div class="flex flex-wrap gap-1.5 text-xs font-mono pt-4 border-t border-base-200/60">
                {% for tag in pillar.tags %}
                  <span class="badge badge-sm badge-ghost">{{ tag }}</span>
                {% endfor %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>

      <!-- Slide Indicator Dots -->
      <div id="pillars-indicators" class="flex justify-center items-center gap-2 mt-6"></div>
    </div>
  </div>
</section>

<script>
  (function() {
    function initPillarsCarousel() {
      var carousel = document.getElementById('pillars-carousel');
      var prevBtn = document.getElementById('pillars-prev');
      var nextBtn = document.getElementById('pillars-next');
      var indicatorsContainer = document.getElementById('pillars-indicators');
      if (!carousel || !prevBtn || !nextBtn) return;

      var items = carousel.querySelectorAll('.carousel-item');
      var totalItems = items.length;
      if (totalItems === 0) return;

      function getItemWidth() {
        var item = carousel.querySelector('.carousel-item');
        if (!item) return 360;
        var style = window.getComputedStyle(carousel);
        var gap = parseFloat(style.gap) || 24;
        return item.getBoundingClientRect().width + gap;
      }

      function scrollToItem(index) {
        var step = getItemWidth();
        carousel.scrollTo({
          left: index * step,
          behavior: 'smooth'
        });
      }

      // Generate indicator dots
      if (indicatorsContainer) {
        indicatorsContainer.innerHTML = '';
        for (var i = 0; i < totalItems; i++) {
          var dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'h-2 rounded-full transition-all duration-300 ' + (i === 0 ? 'bg-primary w-6' : 'bg-base-content/20 hover:bg-base-content/40 w-2');
          dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
          dot.dataset.index = i;
          dot.addEventListener('click', function(e) {
            var targetIndex = parseInt(e.currentTarget.dataset.index, 10);
            scrollToItem(targetIndex);
          });
          indicatorsContainer.appendChild(dot);
        }
      }

      function updateControls() {
        var scrollLeft = carousel.scrollLeft;
        var maxScroll = carousel.scrollWidth - carousel.clientWidth;
        var step = getItemWidth();
        var activeIndex = Math.round(scrollLeft / step);
        if (activeIndex < 0) activeIndex = 0;
        if (activeIndex >= totalItems) activeIndex = totalItems - 1;

        if (indicatorsContainer) {
          var dots = indicatorsContainer.querySelectorAll('button');
          dots.forEach(function(d, idx) {
            if (idx === activeIndex) {
              d.className = 'h-2 rounded-full transition-all duration-300 bg-primary w-6';
            } else {
              d.className = 'h-2 rounded-full transition-all duration-300 bg-base-content/20 hover:bg-base-content/40 w-2';
            }
          });
        }

        if (scrollLeft <= 5) {
          prevBtn.classList.add('opacity-40');
        } else {
          prevBtn.classList.remove('opacity-40');
        }

        if (scrollLeft >= maxScroll - 5) {
          nextBtn.classList.add('opacity-40');
        } else {
          nextBtn.classList.remove('opacity-40');
        }
      }

      prevBtn.addEventListener('click', function() {
        var step = getItemWidth();
        if (carousel.scrollLeft <= 5) {
          carousel.scrollTo({ left: carousel.scrollWidth, behavior: 'smooth' });
        } else {
          carousel.scrollBy({ left: -step, behavior: 'smooth' });
        }
      });

      nextBtn.addEventListener('click', function() {
        var step = getItemWidth();
        var maxScroll = carousel.scrollWidth - carousel.clientWidth;
        if (carousel.scrollLeft >= maxScroll - 5) {
          carousel.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          carousel.scrollBy({ left: step, behavior: 'smooth' });
        }
      });

      carousel.addEventListener('scroll', function() {
        window.requestAnimationFrame(updateControls);
      }, { passive: true });

      // Mouse drag support
      var isDown = false;
      var startX, scrollLeftPos;

      carousel.addEventListener('mousedown', function(e) {
        isDown = true;
        startX = e.pageX - carousel.offsetLeft;
        scrollLeftPos = carousel.scrollLeft;
        carousel.classList.add('cursor-grabbing');
      });

      window.addEventListener('mouseup', function() {
        if (isDown) {
          isDown = false;
          carousel.classList.remove('cursor-grabbing');
        }
      });

      carousel.addEventListener('mousemove', function(e) {
        if (!isDown) return;
        e.preventDefault();
        var x = e.pageX - carousel.offsetLeft;
        var walk = (x - startX) * 1.5;
        carousel.scrollLeft = scrollLeftPos - walk;
      });

      window.addEventListener('resize', updateControls);
      updateControls();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPillarsCarousel);
    } else {
      initPillarsCarousel();
    }
  })();
</script>

<!-- Latest Articles Preview -->
<section class="max-w-6xl mx-auto px-4 sm:px-6 py-20">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12">
    <div>
      <h2 class="text-2xl sm:text-3xl font-black tracking-tight">
        {{ blogSectionTitle or "Recent Thoughts" }}
      </h2>
    </div>
    <a href="/blog/" class="btn btn-outline rounded-lg font-bold">
      Read All Articles →
    </a>
  </div>

  {% if collections.post and collections.post.length > 0 %}
    <ul class="list bg-base-100 border-t border-base-200">
      {% for post in collections.post | reverse | limit(3) %}
        {{ articleCard(post) }}
      {% endfor %}
    </ul>
  {% else %}
    <div class="py-16 text-center">
      <p class="text-base sm:text-lg text-base-content/60 font-medium">Nothing here for now</p>
    </div>
  {% endif %}
</section>

