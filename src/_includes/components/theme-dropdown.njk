<div class="dropdown dropdown-end">
  <div
    tabindex="0"
    role="button"
    class="btn btn-ghost btn-circle btn-sm"
    title="Toggle Theme: Emerald (Light) / Coffee (Dark)"
    aria-label="Select Theme"
  >
    <!-- Emerald / Light Mode Icon (Shown when active theme is emerald) -->
    <svg class="h-5 w-5 text-emerald-600 theme-icon-emerald" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
    </svg>
    <!-- Coffee / Dark Mode Icon (Shown when active theme is coffee) -->
    <svg class="h-5 w-5 text-amber-500 hidden theme-icon-coffee" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 8h1a4 4 0 010 8h-1M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8zM6 1v3M10 1v3M14 1v3" />
    </svg>
  </div>
  <ul
    tabindex="0"
    class="dropdown-content z-60 p-2 shadow-xl bg-base-200 rounded-2xl w-44 mt-3 text-sm font-semibold border border-base-300"
  >
    <li class="menu-title text-[11px] font-mono tracking-wider uppercase opacity-60">Color Theme</li>
    <li>
      <button type="button" class="py-2 flex items-center justify-between rounded-xl" onclick="setTheme('emerald')">
        <span class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-[#10b981] ring-1 ring-black/10"></span>
          <span>Emerald</span>
        </span>
        <span class="text-[10px] font-mono opacity-60 uppercase">Light</span>
      </button>
    </li>
    <li>
      <button type="button" class="py-2 flex items-center justify-between rounded-xl" onclick="setTheme('coffee')">
        <span class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-[#db924b] ring-1 ring-black/10"></span>
          <span>Coffee</span>
        </span>
        <span class="text-[10px] font-mono opacity-60 uppercase">Dark</span>
      </button>
    </li>
  </ul>
</div>
