{% macro articleCard(post) %}
  <article class="card bg-base-100 border border-base-200 hover:border-primary/60 transition-colors rounded-3xl overflow-hidden group">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 p-6 sm:p-7 items-center">
      <!-- Thumbnail / Banner Image Container -->
      {% if post.data.image %}
        <div class="md:col-span-4 w-full">
          <a
            href="{{ post.url }}"
            class="block relative aspect-video md:aspect-4/3 rounded-2xl overflow-hidden bg-base-200 border border-base-200/80"
          >
            <img
              src="{{ post.data.image }}"
              alt="{{ post.data.title }}"
              class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
              loading="lazy"
            />
          </a>
        </div>
      {% endif %}

      <!-- Article Content -->
      <div class="{{ 'md:col-span-8' if post.data.image else 'md:col-span-12' }} flex flex-col justify-between h-full space-y-3">
        <!-- Byline & Meta -->
        <div class="flex flex-wrap items-center gap-2.5 text-xs text-base-content/65">
          <div class="flex items-center gap-1.5 font-medium text-base-content">
            <div class="avatar placeholder">
              <div class="bg-primary text-primary-content rounded-full w-5 h-5 text-[10px] font-bold flex items-center justify-center">
                {{ (post.data.author or 'P')[0] }}
              </div>
            </div>
            <span>{{ post.data.author or "Parag Chatterjee" }}</span>
          </div>
          <span>•</span>
          <time datetime="{{ post.date }}">{{ post.date | readableDate }}</time>
          <span>•</span>
          <span>4 min read</span>
        </div>

        <!-- Title & Excerpt -->
        <div>
          <h2 class="text-xl sm:text-2xl font-black group-hover:text-primary transition-colors leading-tight mb-2">
            <a href="{{ post.url }}">{{ post.data.title }}</a>
          </h2>
          <p class="text-base-content/75 text-sm sm:text-base leading-relaxed line-clamp-2">
            {{ post.data.description }}
          </p>
        </div>

        <!-- Footer: Tags & Read Button -->
        <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
          <div class="flex flex-wrap gap-1.5">
            {% if post.data.tags %}
              {% for tag in post.data.tags %}
                {% if tag != "post" %}
                  <span
                    class="badge badge-sm badge-ghost font-mono text-[11px]"
                  >{{ tag }}</span>
                {% endif %}
              {% endfor %}
            {% endif %}
          </div>

          <div class="flex items-center gap-3">
            <a
              href="{{ post.url }}"
              class="text-sm font-bold text-primary group-hover:underline flex items-center gap-1"
            >
              <span>Read Story</span>
              <span>→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </article>
{% endmacro %}
