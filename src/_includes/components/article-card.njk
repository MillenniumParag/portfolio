{% macro articleCard(post) %}
  <li
    class="list-row hover:bg-base-200/50 transition-colors items-center gap-4 p-4 sm:p-5 article-card"
  >
    <!-- Article Cover Image -->
    <div class="shrink-0">
      <a href="{{ post.url }}" class="block group">
        {% if post.data.image %}
          <img
            src="{{ post.data.image }}"
            alt="{{ post.data.title }}"
            class="size-16 sm:size-20 rounded-2xl object-cover bg-base-200 border border-base-200 shadow-xs transition-transform duration-300 group-hover:scale-105"
            loading="lazy"
          />
        {% else %}
          <div class="size-16 sm:size-20 rounded-2xl bg-secondary/10 border border-secondary/20 flex items-center justify-center text-secondary font-bold text-xl shadow-xs transition-transform duration-300 group-hover:scale-105">
            {{ (post.data.title or 'P')[0] }}
          </div>
        {% endif %}
      </a>
    </div>

    <!-- Main Content (list-col-grow) -->
    <div class="list-col-grow min-w-0 space-y-1">
      <div class="flex flex-wrap items-center gap-2">
        <a
          href="{{ post.url }}"
          class="font-bold text-base sm:text-lg text-base-content hover:text-primary transition-colors leading-snug"
        >
          {{ post.data.title }}
        </a>
        {% if post.data.featured %}
          <span class="badge badge-sm badge-accent font-bold text-[11px]">Featured</span>
        {% endif %}
      </div>

      <p class="text-xs sm:text-sm text-base-content/75 line-clamp-2 leading-relaxed">
        {{ post.data.description }}
      </p>

      <!-- Meta Byline & Tags -->
      <div class="flex flex-wrap items-center gap-2 pt-1 text-xs text-base-content/60">
        <time datetime="{{ post.date }}">{{ post.date | readableDate }}</time>
        <span>•</span>
        <span>4 min read</span>
        {% if post.data.tags %}
          <span class="hidden sm:inline">•</span>
          <div class="hidden sm:flex flex-wrap gap-1">
            {% for tag in post.data.tags %}
              {% if tag != "post" %}
                <span class="badge badge-xs badge-ghost font-mono text-[10px]">{{
                  tag
                }}</span>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>

    <!-- Read Action Button -->
    <div class="shrink-0">
      <a
        href="{{ post.url }}"
        class="btn btn-sm btn-ghost btn-circle text-primary hover:bg-primary hover:text-primary-content transition-colors"
        title="Read Article"
        aria-label="Read {{ post.data.title }}"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="size-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"
          />
        </svg>
      </a>
    </div>
  </li>
{% endmacro %}
