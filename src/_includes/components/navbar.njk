<!-- Navigation Bar using daisyUI navbar -->
<header class="sticky top-0 z-50 backdrop-blur-xl bg-base-100/85 border-b border-base-200/80 transition-colors print:hidden">
  <nav class="navbar max-w-6xl mx-auto px-4 sm:px-6">
    <div class="navbar-start">
      <!-- Mobile Menu Dropdown -->
      <div class="dropdown">
        <div
          tabindex="0"
          role="button"
          class="btn btn-ghost btn-circle lg:hidden"
          aria-label="Open navigation menu"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"
            />
          </svg>
        </div>
        <ul
          tabindex="0"
          class="menu menu-md dropdown-content mt-3 z-60 p-3 shadow-sm bg-base-200 rounded-2xl w-64 border border-base-300"
        >
          <li>
            <a href="/" class="{% if page.url == '/' %}active font-bold text-primary{% endif %} flex items-center gap-2.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
              <span>Home</span>
            </a>
          </li>
          <li>
            <a href="/about/" class="{% if page.url == '/about/' %}active font-bold text-primary{% endif %} flex items-center gap-2.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              <span>About</span>
            </a>
          </li>
          <li>
            <a href="/blog/" class="{% if '/blog/' in page.url or '/posts/' in page.url %}active font-bold text-primary{% endif %} flex items-center gap-2.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
              </svg>
              <span>Blog</span>
            </a>
          </li>
          <li>
            <a href="/projects/" class="{% if '/projects/' in page.url %}active font-bold text-primary{% endif %} flex items-center gap-2.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
              <span>Portfolio</span>
            </a>
          </li>
          <li>
            <a href="/resume/" class="{% if page.url == '/resume/' %}active font-bold text-primary{% endif %} flex items-center gap-2.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span>Resume</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Brand Logo -->
      <a
        href="/"
        class="btn btn-ghost text-lg sm:text-xl font-extrabold tracking-tight px-2"
      >
        <span>Parag <span class="text-primary">Chatterjee</span></span>
      </a>
    </div>

    <!-- Desktop Menu: Home, About, Blog, Portfolio, Resume -->
    <div class="navbar-center hidden lg:flex">
      <ul class="menu menu-horizontal px-1 font-semibold gap-1 text-sm">
        <li>
          <a
            href="/"
            class="rounded-lg {% if page.url == '/' %}text-primary bg-primary/10{% endif %}"
          >Home</a>
        </li>
        <li>
          <a
            href="/about/"
            class="rounded-lg {% if page.url == '/about/' %}text-primary bg-primary/10{% endif %}"
          >About</a>
        </li>
        <li>
          <a
            href="/blog/"
            class="rounded-lg {% if '/blog/' in page.url or '/posts/' in page.url %}text-primary bg-primary/10{% endif %}"
          >Blog</a>
        </li>
        <li>
          <a
            href="/projects/"
            class="rounded-lg {% if '/projects/' in page.url %}text-primary bg-primary/10{% endif %}"
          >Portfolio</a>
        </li>
        <li>
          <a
            href="/resume/"
            class="rounded-lg {% if page.url == '/resume/' %}text-primary bg-primary/10{% endif %}"
          >Resume</a>
        </li>
      </ul>
    </div>

    <div class="navbar-end">
      <!-- Clean, no LinkedIn button -->
    </div>
  </nav>
</header>
