---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>Parag Chatterjee — Engineering Thoughts &amp; Insights</title>
  <subtitle>Articles on full-stack development, modern frontend, and cloud architectures.</subtitle>
  <link href="{{ site.url or 'https://paragchatterjee.me' }}/feed.xml" rel="self" />
  <link href="{{ site.url or 'https://paragchatterjee.me' }}/" />
  <id>{{ site.url or 'https://paragchatterjee.me' }}/</id>
  <author>
    <name>Parag Chatterjee</name>
    <uri>{{ site.url or 'https://paragchatterjee.me' }}/</uri>
  </author>
  {% for post in collections.post | reverse %}
    <entry>
      <title>{{ post.data.title }}</title>
      <link href="{{ site.url or 'https://paragchatterjee.me' }}{{ post.url }}" />
      <updated>{{ post.date.toISOString() }}</updated>
      <id>{{ site.url or 'https://paragchatterjee.me' }}{{ post.url }}</id>
      <summary>{{ post.data.description }}</summary>
    </entry>
  {% endfor %}
</feed>
