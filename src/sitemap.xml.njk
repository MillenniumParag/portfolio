---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd">
{%- for item in collections.all %}
  {%- if item.url and not item.data.noindex and not item.data.eleventyExcludeFromCollections and item.url != '/admin/' and item.url != '/404.html' and item.url != '/uses/' %}
  <url>
    <loc>{{ site.url or 'https://paragchatterjee.me' }}{{ item.url }}</loc>
    {%- if item.date %}
    <lastmod>{{ item.date.toISOString() if item.date.toISOString else item.date }}</lastmod>
    {%- endif %}
    {%- if item.url == '/' %}
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
    {%- elif item.url == '/about/' or item.url == '/projects/' or item.url == '/experience/' or item.url == '/resume/' %}
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
    {%- elif item.url == '/blog/' %}
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
    {%- elif item.url.startsWith('/projects/') or item.url.startsWith('/posts/') %}
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
    {%- else %}
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
    {%- endif %}
  </url>
  {%- endif %}
{%- endfor %}
</urlset>
